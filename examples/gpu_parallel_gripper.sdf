<?xml version="1.0"?>
<sdf version="1.12">
  <world name="default">
    <gravity>0 0 -9.81</gravity>
    <physics name="local" type="ignored"><max_step_size>0.001</max_step_size><real_time_factor>1</real_time_factor></physics>
    <plugin name="gz::sim::systems::GpuBatch" filename="gz-sim-gpu-batch-system">
      <environment id="12" profile="parallel-gripper" model="gripper" object="parcel" plane="table::base" lift="lift" left="left_slider" right="right_slider">
        <drive joint="lift" stiffness="270" damping="23" target="0"/>
        <drive joint="left_slider" stiffness="1100" damping="16" target="0.028"/>
        <drive joint="right_slider" stiffness="1100" damping="16" target="-0.028"/>
        <target tick="201" lift="0.122" left="0.028" right="-0.028"/>
        <target tick="651" lift="0.122" left="0" right="0"/>
      </environment>
    </plugin>
    <model name="table"><static>true</static><link name="base">
      <collision name="plane"><geometry><plane><normal>0 0 1</normal><size>2 2</size></plane></geometry><surface><friction><ode><mu>0.3</mu><mu2>0.3</mu2></ode></friction></surface></collision>
      <visual name="surface"><pose>0 0 -0.009 0 0 0</pose><geometry><box><size>0.32 0.12 0.018</size></box></geometry><material><diffuse>0.34 0.41 0.46 1</diffuse></material></visual>
    </link></model>
    <model name="gripper">
      <link name="carriage"><pose>0 0 0.108 0 0 0</pose>
        <inertial><mass>0.38</mass><inertia><ixx>0.0001</ixx><iyy>0.0001</iyy><izz>0.0001</izz></inertia></inertial>
        <visual name="rail"><geometry><box><size>0.15 0.035 0.015</size></box></geometry><material><diffuse>0.10 0.68 0.75 1</diffuse></material></visual>
      </link>
      <link name="left"><pose>-0.05 0 0.028 0 0 0</pose>
        <inertial><mass>0.12</mass><inertia><ixx>.0001</ixx><iyy>.0001</iyy><izz>.0001</izz></inertia></inertial>
        <collision name="pad"><geometry><box><size>.012 .064 .036</size></box></geometry><surface><friction><ode><mu>0.6</mu><mu2>0.6</mu2></ode></friction></surface></collision>
        <visual name="pad"><geometry><box><size>.012 .064 .036</size></box></geometry><material><diffuse>0.98 0.58 0.13 1</diffuse></material></visual>
        <visual name="stem"><pose>0 0 0.044 0 0 0</pose><geometry><box><size>.008 .016 .061</size></box></geometry><material><diffuse>0.62 0.71 0.76 1</diffuse></material></visual>
      </link>
      <link name="right"><pose>0.05 0 0.028 0 0 0</pose>
        <inertial><mass>0.12</mass><inertia><ixx>.0001</ixx><iyy>.0001</iyy><izz>.0001</izz></inertia></inertial>
        <collision name="pad"><geometry><box><size>.012 .064 .036</size></box></geometry><surface><friction><ode><mu>0.6</mu><mu2>0.6</mu2></ode></friction></surface></collision>
        <visual name="pad"><geometry><box><size>.012 .064 .036</size></box></geometry><material><diffuse>0.98 0.58 0.13 1</diffuse></material></visual>
        <visual name="stem"><pose>0 0 0.044 0 0 0</pose><geometry><box><size>.008 .016 .061</size></box></geometry><material><diffuse>0.62 0.71 0.76 1</diffuse></material></visual>
      </link>
      <joint name="lift" type="prismatic"><parent>world</parent><child>carriage</child>
        <axis><xyz>0 0 1</xyz><limit><lower>-0.008</lower><upper>0.192</upper><effort>25</effort></limit></axis></joint>
      <joint name="left_slider" type="prismatic"><parent>carriage</parent><child>left</child>
        <axis><xyz>1 0 0</xyz><limit><lower>-0.02</lower><upper>0.035</upper><effort>9</effort></limit></axis></joint>
      <joint name="right_slider" type="prismatic"><parent>carriage</parent><child>right</child>
        <axis><xyz>1 0 0</xyz><limit><lower>-0.035</lower><upper>0.02</upper><effort>9</effort></limit></axis></joint>
    </model>
    <model name="parcel"><pose>0 0 0.022 0 0 0</pose><link name="ball">
      <inertial><mass>0.08</mass><inertia><ixx>0.000015488</ixx><iyy>0.000015488</iyy><izz>0.000015488</izz></inertia></inertial>
      <collision name="sphere"><geometry><sphere><radius>0.022</radius></sphere></geometry><surface><friction><ode><mu>1</mu><mu2>1</mu2></ode></friction></surface></collision>
      <visual name="sphere"><geometry><sphere><radius>0.022</radius></sphere></geometry><material><diffuse>0.84 0.16 0.40 1</diffuse></material></visual>
      <visual name="marker"><pose>0.014 0.015 0 0 0 0</pose><geometry><sphere><radius>0.005</radius></sphere></geometry><material><diffuse>1 0.95 0.12 1</diffuse></material></visual>
    </link></model>
  </world>
</sdf>
