<sdf version="1.12">
  <world name="default">
    <gravity>0 0 -9.81</gravity>
    <physics name="five_ms" type="ignored"><max_step_size>0.005</max_step_size></physics>
    <model name="roller">
      <!-- The prescribed guide and material initially share a horizontal velocity. -->
      <pose>0.15 -0.135 0.47 0 0 0</pose>
      <link name="guide">
        <kinematic>true</kinematic>
        <inertial><mass>2</mass><inertia><ixx>0.27</ixx><iyy>0.27</iyy><izz>0.05</izz></inertia></inertial>
        <collision name="capsule"><geometry><capsule><radius>0.08</radius><length>0.30</length></capsule></geometry></collision>
        <visual name="blue"><geometry><capsule><radius>0.08</radius><length>0.30</length></capsule></geometry>
          <material><diffuse>0.1 0.4 0.69 1</diffuse></material></visual>
      </link>
      <plugin name="gz::sim::systems::PrescribedMotion" filename="gz-sim-prescribed-motion-system">
        <linear_velocity>0 0.06 0</linear_velocity>
        <angular_velocity>0 0 0</angular_velocity>
      </plugin>
    </model>
    <model name="roller_b">
      <!-- The prescribed guide and material initially share a horizontal velocity. -->
      <pose>-0.15 0.135 0.47 0 0 0</pose>
      <link name="guide">
        <kinematic>true</kinematic>
        <inertial><mass>2</mass><inertia><ixx>0.27</ixx><iyy>0.27</iyy><izz>0.05</izz></inertia></inertial>
        <collision name="capsule"><geometry><capsule><radius>0.08</radius><length>0.30</length></capsule></geometry></collision>
        <visual name="blue"><geometry><capsule><radius>0.08</radius><length>0.30</length></capsule></geometry>
          <material><diffuse>0.1 0.4 0.69 1</diffuse></material></visual>
      </link>
      <plugin name="gz::sim::systems::PrescribedMotion" filename="gz-sim-prescribed-motion-system">
        <linear_velocity>0 0.06 0</linear_velocity>
        <angular_velocity>0 0 0</angular_velocity>
      </plugin>
    </model>
    <plugin name="gz::sim::systems::Deformables" filename="gz-sim-deformables-system">
      <capsule link="default::roller::guide" coupling="one_way"/>
      <capsule link="default::roller_b::guide" coupling="one_way"/>
      <plane point="0 0 0.12" normal="0 0 1"/>
      <cloth name="material" substeps="4" iterations="10" radius="0.02" self_contact="false" capsule_contact="material" conserve_angular_momentum="true" friction="0" stretch="0.0000001" bend="0.0000001" columns="2" shear="0.0000001">
        <particle position="-0.3 -0.27 0.94" velocity="0 0.06 -0.3" mass="0.05"/>
        <particle position="0.3 -0.27 0.94" velocity="0 0.06 -0.3" mass="0.05"/>
        <particle position="-0.3 0.27 0.94" velocity="0 0.06 -0.3" mass="0.05"/>
        <particle position="0.3 0.27 0.94" velocity="0 0.06 -0.3" mass="0.05"/>
      </cloth>
    </plugin>
  </world>
</sdf>
