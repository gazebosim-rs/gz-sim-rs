<?xml version="1.0"?>
<!-- A yawing foot spans two finite, independently translating frictionless supports. -->
<sdf version="1.12">
  <world name="default">
    <gravity>2.00224103850436563 2.07328293193833124 -9.38112619613776388</gravity>
    <physics name="fixed" type="ignored"><max_step_size>0.0005</max_step_size><real_time_factor>1</real_time_factor></physics>

    <plugin name="gz::sim::systems::PrimaryContactRefinement" filename="gz-sim-primary-contact-refinement-system"><native_steps>8</native_steps><solver_iterations>4</solver_iterations><pair><foot>default::rocker::foot</foot><support>default::lift::pad</support><follow_frictionless_face>true</follow_frictionless_face><share_coplanar_face>true</share_coplanar_face></pair><pair><foot>default::rocker::foot</foot><support>default::toe::pad</support><follow_frictionless_face>true</follow_frictionless_face><share_coplanar_face>true</share_coplanar_face></pair></plugin>
    <model name="rocker">
      <pose>1.30563151170746017 -1.95380339159581440 0.60240036219192949 0.19241626153905794 -0.21977465941192242 0.16785812896489924</pose>
      <plugin name="gz::sim::systems::InitialVelocity" filename="gz-sim-initial-velocity-system">
        <linear_velocity>0.57059658337495400 -0.28885646724853559 0.26866611317679223</linear_velocity><angular_velocity>-0.71611829370329672 -0.89717699451020261 3.83174216642314303</angular_velocity>
      </plugin>
      <plugin name="gz::sim::systems::SwitchableArticulation" filename="gz-sim-switchable-articulation-system">
        <exact_revolute_locks>true</exact_revolute_locks>
      </plugin>
      <link name="foot">
        <inertial><mass>1.00000000000000000</mass><inertia><ixx>0.01610000000000000</ixx><iyy>0.02160000000000000</iyy><izz>0.02950000000000000</izz><ixy>0.00100000000000000</ixy><ixz>-0.00400000000000000</ixz><iyz>0.00300000000000000</iyz></inertia></inertial>
        <collision name="sole"><geometry><box><size>0.36 0.20 0.12</size></box></geometry><surface><friction><ode><mu>0</mu><mu2>0</mu2></ode></friction></surface></collision>
        <visual name="sole"><geometry><box><size>0.36 0.20 0.12</size></box></geometry><material><diffuse>0.92 0.46 0.12 1</diffuse></material></visual>
      </link>
      <link name="upper">
        <pose>0 0 0.14 0 0 0</pose>
        <inertial><mass>1.00000000000000000</mass><inertia><ixx>0.01610000000000000</ixx><iyy>0.02160000000000000</iyy><izz>0.02950000000000000</izz><ixy>0.00100000000000000</ixy><ixz>-0.00400000000000000</ixz><iyz>0.00300000000000000</iyz></inertia></inertial>
        <collision name="c"><geometry><box><size>0.10 0.12 0.12</size></box></geometry><surface><friction><ode><mu>0</mu><mu2>0</mu2></ode></friction></surface></collision>
        <visual name="v"><geometry><box><size>0.10 0.12 0.12</size></box></geometry><material><diffuse>0.90 0.73 0.21 1</diffuse></material></visual>
      </link>
      <joint name="hinge" type="revolute">
        <parent>foot</parent><child>upper</child>
        <axis><xyz>1 0 0</xyz><limit><lower>0</lower><upper>0</upper></limit></axis>
      </joint>
    </model>
    <model name="lift"><pose>1.27300365741521238 -1.88861761561190455 0.48629593620540917 0.18799002387009539 -0.22355595777209017 0.18799002387009539</pose>
      <plugin name="gz::sim::systems::PrescribedMotion" filename="gz-sim-prescribed-motion-system"><linear_velocity>-0.04922494308156252 -0.02946325961006184 0.21356221883040791</linear_velocity><angular_velocity>0 0 0</angular_velocity></plugin>
      <link name="pad"><collision name="platform"><geometry><box><size>0.20999999999999999 0.20999999999999999 0.12</size></box></geometry><surface><friction><ode><mu>0</mu><mu2>0</mu2></ode></friction></surface></collision><visual name="platform"><geometry><box><size>0.20999999999999999 0.20999999999999999 0.12</size></box></geometry><material><diffuse>0.28 0.57 0.30 1</diffuse></material></visual></link></model>
    <model name="toe"><pose>1.55831832832376760 -1.86929655942059503 0.54414258997202813 0.25818709346751428 -0.13593296343533715 -0.19952026805453138</pose>
      <plugin name="gz::sim::systems::PrescribedMotion" filename="gz-sim-prescribed-motion-system"><linear_velocity>0.20165519857940845 -0.17228964262203389 0.22700762086562473</linear_velocity><angular_velocity>0 0 0</angular_velocity></plugin>
      <link name="pad"><collision name="platform"><geometry><box><size>0.22000000000000000 0.23999999999999999 0.12</size></box></geometry><surface><friction><ode><mu>0</mu><mu2>0</mu2></ode></friction></surface></collision><visual name="platform"><geometry><box><size>0.22000000000000000 0.23999999999999999 0.12</size></box></geometry><material><diffuse>0.15 0.40 0.75 1</diffuse></material></visual></link></model>
  </world>
</sdf>
