<!-- Select Rapier in the application. The centered IMU is rolled 90 degrees:
     angular velocity is rad/s and specific force is m/s^2 in sensor axes.
     At rest its +Y axis reports +9.81; ideal free fall reports zero. -->
<sdf version="1.12">
  <world name="default">
    <gravity>0 0 -9.81</gravity>
    <physics name="imu_step" type="ode">
      <max_step_size>0.001</max_step_size>
    </physics>
    <model name="ground">
      <static>true</static>
      <pose>0 0 -0.5 0 0 0</pose>
      <link name="body">
        <inertial>
          <mass>1</mass>
          <inertia><ixx>1</ixx><iyy>1</iyy><izz>1</izz></inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>12 12 1</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>12 12 1</size></box></geometry>
          <material><diffuse>0.35 0.38 0.42 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="imu_box">
      <pose>0 0 3 0 0 0</pose>
      <link name="body">
        <inertial>
          <mass>2</mass>
          <inertia>
            <ixx>0.3333333333333333</ixx>
            <iyy>0.3333333333333333</iyy>
            <izz>0.3333333333333333</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>1 1 1</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1 1 1</size></box></geometry>
          <material><diffuse>0.15 0.55 0.9 1</diffuse></material>
        </visual>
        <sensor name="imu" type="imu">
          <pose>0 0 0 1.5707963267948966 0 0</pose>
          <always_on>true</always_on>
          <update_rate>100</update_rate>
          <topic>/mvp/imu</topic>
          <frame_id>imu_box/body/imu</frame_id>
          <imu><enable_orientation>true</enable_orientation></imu>
        </sensor>
      </link>
    </model>
  </world>
</sdf>
