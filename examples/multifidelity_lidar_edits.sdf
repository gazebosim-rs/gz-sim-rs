<sdf version="1.12">
  <world name="default">
    <gravity>0 0 0</gravity>
    <physics name="clock" type="ignored"><max_step_size>0.005</max_step_size><real_time_factor>0.35</real_time_factor></physics>
    <!-- The scanner moves on a prescribed horizontal path. It sees copies of the
         orange inspection sphere, the gray backstop, and the original sphere. The sensor excludes its own link. -->
    <model name="scanner">
      <pose>-1.4 0 0.45 0 0 0</pose>
      <plugin filename="gz-sim-prescribed-motion-system" name="gz::sim::systems::PrescribedMotion">
        <linear_velocity>0.2 0 0</linear_velocity><angular_velocity>0 0 0</angular_velocity>
      </plugin>
      <link name="body">
        <inertial><mass>1</mass><inertia><ixx>0.015</ixx><iyy>0.025</iyy><izz>0.025</izz></inertia></inertial>
        <collision name="box"><geometry><box><size>0.46 0.3 0.25</size></box></geometry></collision>
        <visual name="paint"><geometry><box><size>0.46 0.3 0.25</size></box></geometry>
          <material><diffuse>0.05 0.37 0.83 1</diffuse></material></visual>
        <sensor name="laser" type="lidar">
          <update_rate>100</update_rate><topic>/scan</topic><frame_id>scanner/body</frame_id>
          <lidar><scan><horizontal><samples>31</samples><resolution>1</resolution><min_angle>-0.6</min_angle><max_angle>0.6</max_angle></horizontal></scan>
            <range><min>0.01</min><max>6</max><resolution>0.001</resolution></range>
          </lidar>
        </sensor>
      </link>
    </model>
    <model name="inspection_sphere">
      <pose>0.7 1.15 0.45 0 0 0</pose><link name="body">
        <inertial><mass>0.8</mass><inertia><ixx>0.0288</ixx><iyy>0.0288</iyy><izz>0.0288</izz></inertia></inertial>
        <collision name="sphere"><geometry><sphere><radius>0.3</radius></sphere></geometry></collision>
        <visual name="paint"><geometry><sphere><radius>0.3</radius></sphere></geometry>
          <material><diffuse>0.94 0.30 0.05 1</diffuse></material></visual>
      </link>
    </model>
    <model name="backstop"><static>true</static><pose>1.65 0 0.45 0 0 0</pose><link name="body">
      <collision name="box"><geometry><box><size>0.2 2.1 0.8</size></box></geometry></collision>
      <visual name="paint"><geometry><box><size>0.2 2.1 0.8</size></box></geometry>
        <material><diffuse>0.38 0.54 0.57 1</diffuse></material></visual>
    </link></model>
  </world>
</sdf>
