<sdf version="1.12">
  <world name="default">
    <gravity>0 0 0</gravity>
    <physics name="ten_ms" type="ignored"><max_step_size>0.01</max_step_size><real_time_factor>0.1</real_time_factor></physics>
    <!-- The blue pusher and orange cargo start on different local physics workers. -->
    <model name="pusher">
      <pose>-1.8 0 0.45 0 0 0</pose>
      <link name="body">
        <inertial><mass>1</mass><inertia>
          <ixx>0.03416666666666667</ixx><iyy>0.05083333333333333</iyy><izz>0.04333333333333333</izz>
        </inertia></inertial>
        <collision name="box">
          <geometry><box><size>0.6 0.4 0.5</size></box></geometry>
          <surface><friction><ode><mu>0</mu><mu2>0</mu2></ode></friction></surface>
        </collision>
        <visual name="paint">
          <geometry><box><size>0.6 0.4 0.5</size></box></geometry>
          <material><diffuse>0.05 0.35 0.88 1</diffuse></material>
        </visual>
      </link>
      <plugin filename="gz-sim-prescribed-motion-system" name="gz::sim::systems::PrescribedMotion">
        <linear_velocity>1.5 0 0</linear_velocity><angular_velocity>0 0 0</angular_velocity>
      </plugin>
    </model>
    <model name="cargo">
      <pose>0.3 0 0.45 0 0 0</pose>
      <link name="body">
        <inertial><mass>1</mass><inertia><ixx>0.06</ixx><iyy>0.06</iyy><izz>0.06</izz></inertia></inertial>
        <collision name="box">
          <geometry><box><size>0.6 0.6 0.6</size></box></geometry>
          <surface><friction><ode><mu>0</mu><mu2>0</mu2></ode></friction></surface>
        </collision>
        <visual name="paint">
          <geometry><box><size>0.6 0.6 0.6</size></box></geometry>
          <material><diffuse>0.94 0.26 0.04 1</diffuse></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
