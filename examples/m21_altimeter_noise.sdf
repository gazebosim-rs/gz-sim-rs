<sdf version='1.12'><world name='default'>
  <gravity>0 0 0</gravity>
  <physics name='step' type='ode'><max_step_size>0.001</max_step_size></physics>
  <model name='rig'><pose>0 0 3 0 0 0</pose><link name='body'>
    <inertial><mass>2</mass>
      <inertia><ixx>1</ixx><iyy>1</iyy><izz>1</izz></inertia></inertial>
    <collision name='shape'><geometry><box><size>1 1 1</size></box></geometry></collision>
    <sensor name='altimeter' type='altimeter'>
      <pose>1 0 0.5 0 1.5707963267948966 0</pose>
      <always_on>true</always_on><update_rate>100</update_rate>
      <topic>/m21/altimeter</topic><frame_id>rig/body/altimeter</frame_id>
      <altimeter>
        <vertical_position><noise type='gaussian'><mean>0.2</mean><stddev>0.1</stddev><bias_stddev>0.05</bias_stddev></noise></vertical_position>
        <vertical_velocity><noise type='gaussian_quantized'><stddev>0.05</stddev><precision>0.01</precision></noise></vertical_velocity>
      </altimeter>
    </sensor>
  </link></model>
</world></sdf>
