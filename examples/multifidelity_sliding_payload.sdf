<?xml version="1.0"?>
<!-- The Rust example settles this world for two physical seconds, then launches the ram. -->
<sdf version="1.12">
  <world name="default">
    <gravity>0 0 -9.81</gravity>
    <physics name="fixed" type="ignored"><max_step_size>0.001</max_step_size></physics>
    <model name="arm">
      <pose>0 0 0.24 0 0 0</pose>
      <plugin name="gz::sim::systems::SwitchableArticulation" filename="gz-sim-switchable-articulation-system"/>
      <link name="base">
        <collision name="c"><geometry><box><size>0.28 0.28 0.28</size></box></geometry></collision>
        <visual name="base"><geometry><box><size>0.28 0.28 0.28</size></box></geometry><material><diffuse>0.12 0.47 0.68 1</diffuse></material></visual>
        <visual name="beam"><pose>0 0.325 0 0 0 0</pose><geometry><box><size>0.065 0.65 0.065</size></box></geometry><material><diffuse>0.12 0.47 0.68 1</diffuse></material></visual>
      </link>
      <link name="tip">
        <pose>0 0.65 0 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.28 0.28 0.28</size></box></geometry></collision>
        <visual name="tip"><geometry><box><size>0.28 0.28 0.28</size></box></geometry><material><diffuse>0.15 0.72 0.64 1</diffuse></material></visual>
      </link>
      <joint name="elbow" type="revolute"><parent>base</parent><child>tip</child><axis><xyz>0 0 1</xyz></axis></joint>
    </model>
    <model name="ram">
      <pose>-1.1 0.71 0.17 0 0 0</pose>
      <link name="head">
        <collision name="c"><geometry><box><size>0.32 0.26 0.32</size></box></geometry></collision>
        <visual name="ram"><geometry><box><size>0.32 0.26 0.32</size></box></geometry><material><diffuse>0.93 0.49 0.16 1</diffuse></material></visual>
      </link>
    </model>
    <model name="floor">
      <static>true</static><pose>0 0 -0.1 0 0 0</pose>
      <link name="ground">
        <collision name="surface"><geometry><box><size>10 10 0.2</size></box></geometry></collision>
        <visual name="surface"><geometry><box><size>10 10 0.2</size></box></geometry><material><diffuse>0.36 0.4 0.44 1</diffuse></material></visual>
      </link>
    </model>
  </world>
</sdf>
