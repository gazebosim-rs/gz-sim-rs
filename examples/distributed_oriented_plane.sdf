<sdf version="1.12"><world name="default">
  <gravity>0 0 -9.81</gravity>
  <physics name="paired_workers" type="ignored"><max_step_size>0.005</max_step_size><real_time_factor>0.22</real_time_factor></physics>
  <!-- The two workers replicate an infinite, tilted collision surface. The
       gray slab displays its neighborhood and has its upper face on the plane. -->
  <model name="slope"><static>true</static><pose>0 0 0.6 0 0 0.38</pose><link name="terrain">
    <collision name="surface"><pose>0.25 0 0.12 0 0.10 0</pose>
      <geometry><plane><normal>0.14943813247359922 0 0.98877107793604224</normal><size>12 8</size></plane></geometry>
      <surface><friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction></surface>
    </collision>
    <visual name="face"><pose>0.24010384162981907 0 0.081243503131574205 0 0.25 0</pose>
      <geometry><box><size>12 8 0.08</size></box></geometry><material><diffuse>0.32 0.39 0.43 1</diffuse></material>
    </visual>
  </link></model>
  <model name="sliding"><pose>-0.67713592247981336 -3.1240164243161663 1.6324754306099956 0 0.25 0.38</pose><link name="body">
    <inertial><mass>2</mass><inertia><ixx>0.09208333333333334</ixx><iyy>0.1233333333333333</iyy><izz>0.1320833333333333</izz></inertia></inertial>
    <collision name="box"><geometry><box><size>0.7 0.55 0.5</size></box></geometry><surface><friction><ode><mu>0.12</mu><mu2>0.12</mu2></ode></friction></surface></collision>
    <visual name="paint"><geometry><box><size>0.7 0.55 0.5</size></box></geometry><material><diffuse>0.96 0.32 0.05 1</diffuse></material></visual>
  </link></model>
  <model name="holding"><pose>-2.6430144103686213 1.7979061442393378 1.6324754306099956 0 0.25 0.38</pose><link name="body">
    <inertial><mass>2</mass><inertia><ixx>0.09208333333333334</ixx><iyy>0.1233333333333333</iyy><izz>0.1320833333333333</izz></inertia></inertial>
    <collision name="box"><geometry><box><size>0.7 0.55 0.5</size></box></geometry><surface><friction><ode><mu>0.9</mu><mu2>0.9</mu2></ode></friction></surface></collision>
    <visual name="paint"><geometry><box><size>0.7 0.55 0.5</size></box></geometry><material><diffuse>0.03 0.72 0.62 1</diffuse></material></visual>
  </link></model>
</world></sdf>
