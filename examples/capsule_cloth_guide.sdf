<sdf version="1.12">
  <world name="default">
    <gravity>0 0 -9.81</gravity>
    <physics name="two_ms" type="ignored"><max_step_size>0.002</max_step_size></physics>
    <model name="roller">
      <!-- The capsule's local Z is world Y. Its crown travels toward +X. -->
      <pose>0 0 0.5 -1.5707963267948966 0 0</pose>
      <link name="guide">
        <kinematic>true</kinematic>
        <inertial><mass>2</mass><inertia><ixx>0.27</ixx><iyy>0.27</iyy><izz>0.05</izz></inertia></inertial>
        <collision name="capsule"><geometry><capsule><radius>0.2</radius><length>1.04</length></capsule></geometry></collision>
        <visual name="blue"><geometry><capsule><radius>0.2</radius><length>1.04</length></capsule></geometry>
          <material><diffuse>0.1 0.4 0.69 1</diffuse></material></visual>
      </link>
      <plugin name="gz::sim::systems::PrescribedMotion" filename="gz-sim-prescribed-motion-system">
        <linear_velocity>0.15 0 0</linear_velocity>
        <angular_velocity>0 6 0</angular_velocity>
      </plugin>
    </model>
    <plugin name="gz::sim::systems::Deformables" filename="gz-sim-deformables-system">
      <capsule link="default::roller::guide" coupling="one_way"/>
      <plane point="0 0 0" normal="0 0 1"/>
      <cloth name="web" columns="5" substeps="4" iterations="16" radius="0.018" self_contact="false"
             friction="0.55" stretch="0.0001" shear="0.00015" bend="0.002">
        <particle position="-0.07 -0.36 1.02" velocity="0.15 0 0" mass="0.01"/>
        <particle position="-0.07 -0.18 1.02" velocity="0.15 0 0" mass="0.01"/>
        <particle position="-0.07 0 1.02" velocity="0.15 0 0" mass="0.01"/>
        <particle position="-0.07 0.18 1.02" velocity="0.15 0 0" mass="0.01"/>
        <particle position="-0.07 0.36 1.02" velocity="0.15 0 0" mass="0.01"/>
        <particle position="0.0 -0.36 1.02" velocity="0.15 0 0" mass="0.01"/>
        <particle position="0.0 -0.18 1.02" velocity="0.15 0 0" mass="0.01"/>
        <particle position="0.0 0 1.02" velocity="0.15 0 0" mass="0.01"/>
        <particle position="0.0 0.18 1.02" velocity="0.15 0 0" mass="0.01"/>
        <particle position="0.0 0.36 1.02" velocity="0.15 0 0" mass="0.01"/>
        <particle position="0.07 -0.36 1.02" velocity="0.15 0 0" mass="0.01"/>
        <particle position="0.07 -0.18 1.02" velocity="0.15 0 0" mass="0.01"/>
        <particle position="0.07 0 1.02" velocity="0.15 0 0" mass="0.01"/>
        <particle position="0.07 0.18 1.02" velocity="0.15 0 0" mass="0.01"/>
        <particle position="0.07 0.36 1.02" velocity="0.15 0 0" mass="0.01"/>
      </cloth>
    </plugin>
  </world>
</sdf>
