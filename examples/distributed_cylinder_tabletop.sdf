<sdf version="1.12">
  <world name="default">
    <gravity>1.25 0 -9.81</gravity>
    <physics name="local_workers" type="ignored">
      <max_step_size>0.002</max_step_size><real_time_factor>0.14</real_time_factor>
    </physics>
    <model name="ground"><static>true</static><link name="floor">
      <collision name="terrain"><geometry><plane><normal>0 0 1</normal><size>8 4</size></plane></geometry>
        <surface><friction><ode><mu>0</mu><mu2>0</mu2></ode></friction></surface></collision>
      <visual name="mat"><pose>1 0 -0.025 0 0 0</pose><geometry><box><size>7 3 0.05</size></box></geometry>
        <material><diffuse>0.31 0.35 0.41 1</diffuse></material></visual>
    </link></model>
    <model name="tabletop"><static>true</static><pose>0 0 0.70 0 0 0</pose><link name="disk">
      <collision name="table"><geometry><cylinder><radius>0.75</radius><length>0.60</length></cylinder></geometry>
        <surface><friction><ode><mu>0</mu><mu2>0</mu2></ode></friction></surface></collision>
      <visual name="blue_table"><geometry><cylinder><radius>0.75</radius><length>0.60</length></cylinder></geometry>
        <material><diffuse>0.10 0.47 0.72 1</diffuse></material></visual>
      <visual name="pedestal"><pose>0 0 -0.50 0 0 0</pose><geometry><cylinder><radius>0.24</radius><length>0.40</length></cylinder></geometry>
        <material><diffuse>0.21 0.26 0.31 1</diffuse></material></visual>
    </link></model>
    <model name="slider"><pose>-0.55 0.12 1.42 0 0 0</pose><link name="ball">
      <inertial><mass>0.6</mass><inertia><ixx>0.003456</ixx><iyy>0.003456</iyy><izz>0.003456</izz></inertia></inertial>
      <collision name="sphere"><geometry><sphere><radius>0.12</radius></sphere></geometry>
        <surface><friction><ode><mu>0</mu><mu2>0</mu2></ode></friction></surface></collision>
      <visual name="orange_ball"><geometry><sphere><radius>0.12</radius></sphere></geometry>
        <material><diffuse>0.96 0.33 0.08 1</diffuse></material></visual>
    </link></model>
  </world>
</sdf>
