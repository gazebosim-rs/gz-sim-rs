<?xml version="1.0"?>
<sdf version="1.12">
  <world name="robot_joints">
    <gravity>0 0 -9.81</gravity>
    <physics name="local" type="ignored"><max_step_size>0.001</max_step_size></physics>
    <model name="rail"><static>true</static><link name="beam"><pose>0 0 0.98 0 0 0</pose>
      <collision name="rail"><geometry><box><size>1.1 0.08 0.06</size></box></geometry></collision>
      <visual name="rail"><geometry><box><size>1.1 0.08 0.06</size></box></geometry><material><diffuse>0.40 0.49 0.57 1</diffuse></material></visual>
    </link></model>
    <model name="robot">
      <link name="carriage"><pose>0 0 0.84 0 0 0</pose>
        <inertial><mass>1.0</mass><inertia><ixx>0.00213333333333</ixx><iyy>0.00276666666667</iyy><izz>0.00276666666667</izz></inertia></inertial>
        <collision name="carriage"><geometry><box><size>0.18 0.16 0.16</size></box></geometry></collision>
        <visual name="carriage"><geometry><box><size>0.18 0.16 0.16</size></box></geometry><material><diffuse>0.14 0.73 0.68 1</diffuse></material></visual>
      </link>
      <link name="tool"><pose>0 0 0.53 0 0 0</pose>
        <inertial><mass>0.4</mass><inertia><ixx>0.00554666666667</ixx><iyy>0.00554666666667</iyy><izz>0.00042666666667</izz></inertia></inertial>
        <collision name="tool"><geometry><box><size>0.08 0.08 0.4</size></box></geometry></collision>
        <visual name="tool"><geometry><box><size>0.08 0.08 0.4</size></box></geometry><material><diffuse>0.95 0.57 0.18 1</diffuse></material></visual>
      </link>
      <joint name="slide" type="prismatic"><parent>world</parent><child>carriage</child>
        <axis><xyz>1 0 0</xyz><limit><lower>-0.40</lower><upper>0.40</upper></limit></axis>
      </joint>
      <joint name="wrist" type="ball"><parent>carriage</parent><child>tool</child><pose>0 0 0.23 0 0 0</pose></joint>
    </model>
  </world>
</sdf>
