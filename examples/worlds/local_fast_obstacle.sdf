<sdf version="1.12">
  <world name="default">
    <gravity>0 0 0</gravity>
    <physics name="fast_links" type="ignored"><max_step_size>0.0001</max_step_size></physics>
    <plugin filename="gz-sim-continuous-collision-system" name="gz::sim::systems::ContinuousCollision">
      <linear_slop>0.0001</linear_slop>
      <link>default::hit::tip</link>
      <link>default::graze::tip</link>
      <link>default::clear::tip</link>
    </plugin>
    <model name="hit">
      <pose>-0.85 -1 0.15 0 0 0</pose>
      <plugin filename="gz-sim-initial-velocity-system" name="gz::sim::systems::InitialVelocity">
        <linear_velocity>100 0 0</linear_velocity><angular_velocity>0 0 0</angular_velocity>
      </plugin>
      <link name="tip">
        <inertial><mass>2</mass><inertia><ixx>0.00288</ixx><iyy>0.00288</iyy><izz>0.00288</izz></inertia></inertial>
        <collision name="surface">
          <geometry><sphere><radius>0.06</radius></sphere></geometry>
          <surface><friction><ode><mu>0</mu><mu2>0</mu2></ode></friction></surface>
        </collision>
        <visual name="tip_view">
          <geometry><sphere><radius>0.06</radius></sphere></geometry>
          <material><ambient>1.0 0.36 0.12 1</ambient><diffuse>1.0 0.36 0.12 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="graze">
      <pose>-0.85 0.405 0.15 0 0 0</pose>
      <plugin filename="gz-sim-initial-velocity-system" name="gz::sim::systems::InitialVelocity">
        <linear_velocity>100 0 0</linear_velocity><angular_velocity>0 0 0</angular_velocity>
      </plugin>
      <link name="tip">
        <inertial><mass>2</mass><inertia><ixx>0.00288</ixx><iyy>0.00288</iyy><izz>0.00288</izz></inertia></inertial>
        <collision name="surface">
          <geometry><sphere><radius>0.06</radius></sphere></geometry>
          <surface><friction><ode><mu>0</mu><mu2>0</mu2></ode></friction></surface>
        </collision>
        <visual name="tip_view">
          <geometry><sphere><radius>0.06</radius></sphere></geometry>
          <material><ambient>0.98 0.72 0.18 1</ambient><diffuse>0.98 0.72 0.18 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="clear">
      <pose>-0.85 1.415 0.15 0 0 0</pose>
      <plugin filename="gz-sim-initial-velocity-system" name="gz::sim::systems::InitialVelocity">
        <linear_velocity>100 0 0</linear_velocity><angular_velocity>0 0 0</angular_velocity>
      </plugin>
      <link name="tip">
        <inertial><mass>2</mass><inertia><ixx>0.00288</ixx><iyy>0.00288</iyy><izz>0.00288</izz></inertia></inertial>
        <collision name="surface">
          <geometry><sphere><radius>0.06</radius></sphere></geometry>
          <surface><friction><ode><mu>0</mu><mu2>0</mu2></ode></friction></surface>
        </collision>
        <visual name="tip_view">
          <geometry><sphere><radius>0.06</radius></sphere></geometry>
          <material><ambient>0.08 0.76 0.60 1</ambient><diffuse>0.08 0.76 0.60 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="hit_guard">
      <static>true</static><pose>0 -1 0.15 0 0 0</pose>
      <link name="rail">
        <collision name="surface">
          <geometry><box><size>0.012 0.70 0.30</size></box></geometry>
          <surface><friction><ode><mu>0</mu><mu2>0</mu2></ode></friction></surface>
        </collision>
        <visual name="rail_view">
          <geometry><box><size>0.012 0.70 0.30</size></box></geometry>
          <material><ambient>0.23 0.41 0.78 1</ambient><diffuse>0.23 0.41 0.78 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="graze_guard">
      <static>true</static><pose>0 0 0.15 0 0 0</pose>
      <link name="rail">
        <collision name="surface">
          <geometry><box><size>0.012 0.70 0.30</size></box></geometry>
          <surface><friction><ode><mu>0</mu><mu2>0</mu2></ode></friction></surface>
        </collision>
        <visual name="rail_view">
          <geometry><box><size>0.012 0.70 0.30</size></box></geometry>
          <material><ambient>0.23 0.41 0.78 1</ambient><diffuse>0.23 0.41 0.78 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="clear_guard">
      <static>true</static><pose>0 1 0.15 0 0 0</pose>
      <link name="rail">
        <collision name="surface">
          <geometry><box><size>0.012 0.70 0.30</size></box></geometry>
          <surface><friction><ode><mu>0</mu><mu2>0</mu2></ode></friction></surface>
        </collision>
        <visual name="rail_view">
          <geometry><box><size>0.012 0.70 0.30</size></box></geometry>
          <material><ambient>0.23 0.41 0.78 1</ambient><diffuse>0.23 0.41 0.78 1</diffuse></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
