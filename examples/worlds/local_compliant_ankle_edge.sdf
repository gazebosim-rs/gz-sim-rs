<sdf version="1.12">
  <world name="default">
    <gravity>0 0 -9.81</gravity>
    <physics name="clock" type="ode"><max_step_size>0.0005</max_step_size></physics>
    <plugin name="gz::sim::systems::DampedSole" filename="gz-sim-damped-sole-system">
      <foot>default::boot::sole</foot><support>default::deck::plate</support>
      <native_ankle>true</native_ankle><ankle_positive_x_edge>true</ankle_positive_x_edge>
      <foot_stiffness>2000000</foot_stiffness><deck_stiffness>3000000</deck_stiffness>
      <damping>2.5</damping><friction>0.32</friction><slip_speed>0.015</slip_speed>
      <substeps>8</substeps><quadrature_depth>1</quadrature_depth>
    </plugin>
    <model name="deck"><static>true</static><link name="plate"><pose>-0.415 0 -0.03 0 0 0</pose>
      <collision name="deck_shape"><geometry><box><size>1.20 0.70 0.06</size></box></geometry><surface><friction><ode><mu>0</mu><mu2>0</mu2></ode></friction></surface></collision>
      <visual name="deck"><geometry><box><size>1.20 0.70 0.06</size></box></geometry><material><diffuse>0.30 0.49 0.48 1</diffuse></material></visual>
    </link></model>
    <model name="boot"><pose>0 0 0.02477291666666667 0 0 0</pose>
      <plugin name="gz::sim::systems::InitialVelocity" filename="gz-sim-initial-velocity-system">
        <linear_velocity>0.75 0 0</linear_velocity><angular_velocity>0 0 0</angular_velocity>
      </plugin>
      <link name="sole">
        <inertial><pose>0 0 0 0 0 0</pose><mass>1</mass><inertia><ixx>0.012</ixx><iyy>0.016</iyy><izz>0.02</izz></inertia></inertial>
        <collision name="sole_shape"><geometry><box><size>0.36 0.20 0.05</size></box></geometry><surface><friction><ode><mu>0</mu><mu2>0</mu2></ode></friction></surface></collision>
        <visual name="sole"><geometry><box><size>0.36 0.20 0.05</size></box></geometry><material><diffuse>0.96 0.55 0.15 1</diffuse></material></visual>
        <visual name="ankle_post"><pose>0 0 0.09 0 0 0</pose><geometry><box><size>0.035 0.045 0.15</size></box></geometry><material><diffuse>0.65 0.50 0.29 1</diffuse></material></visual>
        <visual name="ankle_pin"><pose>0 0 0.16 1.5707963267948966 0 0</pose><geometry><sphere><radius>0.024</radius></sphere></geometry><material><diffuse>0.85 0.76 0.52 1</diffuse></material></visual>
      </link>
      <link name="upper"><pose>-0.18504230415763367 0 0.08410964704236909 0 -1.96 0</pose>
        <inertial><pose>0 0 0 0 0 0</pose><mass>1</mass><inertia><ixx>0.012</ixx><iyy>0.011</iyy><izz>0.002</izz></inertia></inertial>
        <collision name="upper_shape"><geometry><box><size>0.08 0.10 0.34</size></box></geometry><surface><friction><ode><mu>0</mu><mu2>0</mu2></ode></friction></surface></collision>
        <visual name="upper"><geometry><box><size>0.08 0.10 0.34</size></box></geometry><material><diffuse>0.19 0.36 0.65 1</diffuse></material></visual>
        <visual name="ankle_lug"><pose>0 0 -0.185 0 0 0</pose><geometry><box><size>0.032 0.055 0.060</size></box></geometry><material><diffuse>0.32 0.47 0.68 1</diffuse></material></visual>
      </link>
      <joint name="ankle" type="revolute"><pose relative_to="sole">0 0 0.16 0 0 0</pose><parent>sole</parent><child>upper</child><axis><xyz>0 1 0</xyz></axis></joint>
    </model>
  </world>
</sdf>
