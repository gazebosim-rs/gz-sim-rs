<sdf version="1.12">
  <world name="default">
    <gravity>0 0 -9.81</gravity>
    <physics name="local" type="ignored"><max_step_size>0.00025</max_step_size></physics>
    <model name="chain">
      <link name="root">
        <pose>0 0 1.40 0 0 0</pose>
        <inertial><mass>0.2</mass><inertia><ixx>0.000166666666667</ixx><iyy>0.000241666666667</iyy><izz>0.000195</izz></inertia></inertial>
        <collision name="body"><geometry><box><size>0.09 0.06 0.08</size></box></geometry></collision>
        <visual name="body"><geometry><box><size>0.09 0.06 0.08</size></box></geometry><material><diffuse>0.25 0.42 0.7 1</diffuse></material></visual>
      </link>
      <link name="bracket">
        <pose>0 0 1.26 0 0 0</pose>
        <inertial><mass>0.2</mass><inertia><ixx>0.000166666666667</ixx><iyy>0.000241666666667</iyy><izz>0.000195</izz></inertia></inertial>
        <collision name="body"><geometry><box><size>0.09 0.06 0.08</size></box></geometry></collision>
        <visual name="body"><geometry><box><size>0.09 0.06 0.08</size></box></geometry><material><diffuse>0.4 0.49 0.57 1</diffuse></material></visual>
      </link>
      <link name="carriage">
        <pose>0 0 1.12 0 0 0</pose>
        <inertial><mass>0.2</mass><inertia><ixx>0.000166666666667</ixx><iyy>0.000241666666667</iyy><izz>0.000195</izz></inertia></inertial>
        <collision name="body"><geometry><box><size>0.09 0.06 0.08</size></box></geometry></collision>
        <visual name="body"><geometry><box><size>0.09 0.06 0.08</size></box></geometry><material><diffuse>0.14 0.7 0.66 1</diffuse></material></visual>
      </link>
      <link name="swivel">
        <pose>0 0 0.98 0 0 0</pose>
        <inertial><mass>0.2</mass><inertia><ixx>0.000166666666667</ixx><iyy>0.000241666666667</iyy><izz>0.000195</izz></inertia></inertial>
        <collision name="body"><geometry><box><size>0.09 0.06 0.08</size></box></geometry></collision>
        <visual name="body"><geometry><box><size>0.09 0.06 0.08</size></box></geometry><material><diffuse>0.9 0.6 0.2 1</diffuse></material></visual>
      </link>
      <link name="yoke">
        <pose>0 0 0.84 0 0 0</pose>
        <inertial><mass>0.2</mass><inertia><ixx>0.000166666666667</ixx><iyy>0.000241666666667</iyy><izz>0.000195</izz></inertia></inertial>
        <collision name="body"><geometry><box><size>0.09 0.06 0.08</size></box></geometry></collision>
        <visual name="body"><geometry><box><size>0.09 0.06 0.08</size></box></geometry><material><diffuse>0.22 0.55 0.8 1</diffuse></material></visual>
      </link>
      <link name="tool">
        <pose>0 0 0.70 0 0 0</pose>
        <inertial><mass>0.5</mass><inertia><ixx>0.000416666666667</ixx><iyy>0.000604166666667</iyy><izz>0.0004875</izz></inertia></inertial>
        <collision name="body"><geometry><box><size>0.09 0.06 0.08</size></box></geometry></collision>
        <visual name="body"><geometry><box><size>0.09 0.06 0.08</size></box></geometry><material><diffuse>0.84 0.35 0.20 1</diffuse></material></visual>
      </link>
      <joint name="shoulder" type="revolute"><parent>world</parent><child>root</child>
        <axis><xyz>0 1 0</xyz><limit><lower>-0.55</lower><upper>0.55</upper></limit></axis>
      </joint>
      <joint name="weld" type="fixed"><parent>root</parent><child>bracket</child>
      </joint>
      <joint name="slide" type="prismatic"><parent>bracket</parent><child>carriage</child>
        <axis><xyz>1 0 0</xyz><limit><lower>-0.06</lower><upper>0.06</upper></limit></axis>
      </joint>
      <joint name="socket" type="ball"><parent>carriage</parent><child>swivel</child>
      </joint>
      <joint name="wrist" type="universal"><parent>swivel</parent><child>yoke</child>
        <axis><xyz>1 0 0</xyz><limit><lower>-0.45</lower><upper>0.45</upper></limit></axis>
        <axis2><xyz>0 1 0</xyz><limit><lower>-0.35</lower><upper>0.35</upper></limit></axis2>
      </joint>
      <joint name="spindle" type="screw"><parent>yoke</parent><child>tool</child>
        <screw_thread_pitch>0.04</screw_thread_pitch>
        <axis><xyz>0 0 1</xyz><limit><lower>-7</lower><upper>7</upper></limit></axis>
      </joint>
      <plugin name="gz::sim::systems::SwitchableArticulation" filename="gz-sim-switchable-articulation-system">
        <additional_pgs_iterations>4</additional_pgs_iterations>
      </plugin>
    </model>
  </world>
</sdf>
