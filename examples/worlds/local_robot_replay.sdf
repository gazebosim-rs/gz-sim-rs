<?xml version="1.0"?>
<sdf version="1.12">
  <world name="default">
    <gravity>0 0 -9.81</gravity>
    <physics name="local" type="ignored"><max_step_size>0.001</max_step_size></physics>
    <model name="stand"><static>true</static>
      <link name="post"><pose>0 0 0.48 0 0 0</pose>
        <collision name="post"><geometry><box><size>0.65 0.65 0.04</size></box></geometry>
          <surface><friction><ode><mu>0.75</mu><mu2>0.75</mu2></ode></friction></surface>
