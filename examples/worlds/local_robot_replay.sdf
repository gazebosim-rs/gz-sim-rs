        <visual name="post"><geometry><box><size>0.65 0.65 0.04</size></box></geometry><material><diffuse>0.36 0.43 0.50 1</diffuse></material></visual>
        <collision name="west"><pose>-0.32 0 0.04 0 0 0</pose><geometry><box><size>0.01 0.65 0.04</size></box></geometry><surface><friction><ode><mu>0.75</mu><mu2>0.75</mu2></ode></friction></surface></collision>
