        <collision name="north"><pose>0 0.32 0.04 0 0 0</pose><geometry><box><size>0.63 0.01 0.04</size></box></geometry><surface><friction><ode><mu>0.75</mu><mu2>0.75</mu2></ode></friction></surface></collision>
