<sdf version="1.12"><world name="default">
  <gravity>0 0 0</gravity>
  <physics name="one_ms" type="ignored"><max_step_size>0.001</max_step_size></physics>
  <model name="hit"><static>true</static><link name="ridge"><pose>-0.24 0 0 0 0 0</pose>
    <collision name="solid"><geometry><box><size>0.05 0.32 0.04</size></box></geometry></collision>
    <visual name="solid"><geometry><box><size>0.05 0.32 0.04</size></box></geometry><material><diffuse>0.35 0.42 0.50 1</diffuse></material></visual>
    <visual name="p0"><pose>-0.059 0 0.108 0 0 0</pose><geometry><sphere><radius>0.006</radius></sphere></geometry><material><diffuse>0.95 0.48 0.09 1</diffuse></material></visual>
    <visual name="p1"><pose>0.133 0 -0.03599999999999999 0 0 0</pose><geometry><sphere><radius>0.006</radius></sphere></geometry><material><diffuse>0.95 0.48 0.09 1</diffuse></material></visual>
    <visual name="p2"><pose>-0.004999999999999998 0 0.18 0 0 0</pose><geometry><sphere><radius>0.006</radius></sphere></geometry><material><diffuse>0.95 0.48 0.09 1</diffuse></material></visual>
    <visual name="p3"><pose>0.187 0 0.036 0 0 0</pose><geometry><sphere><radius>0.006</radius></sphere></geometry><material><diffuse>0.95 0.48 0.09 1</diffuse></material></visual>
  </link></model>
  <model name="miss"><static>true</static><link name="ridge"><pose>0.24 0 0 0 0 0</pose>
    <collision name="solid"><geometry><box><size>0.05 0.32 0.04</size></box></geometry></collision>
    <visual name="solid"><geometry><box><size>0.05 0.32 0.04</size></box></geometry><material><diffuse>0.35 0.42 0.50 1</diffuse></material></visual>
    <visual name="p0"><pose>-0.059 0.08081109715734115 0.108 0 0 0</pose><geometry><sphere><radius>0.006</radius></sphere></geometry><material><diffuse>0.14 0.70 0.63 1</diffuse></material></visual>
    <visual name="p1"><pose>0.133 0.08081109715734115 -0.03599999999999999 0 0 0</pose><geometry><sphere><radius>0.006</radius></sphere></geometry><material><diffuse>0.14 0.70 0.63 1</diffuse></material></visual>
    <visual name="p2"><pose>-0.004999999999999998 0.08081109715734115 0.18 0 0 0</pose><geometry><sphere><radius>0.006</radius></sphere></geometry><material><diffuse>0.14 0.70 0.63 1</diffuse></material></visual>
    <visual name="p3"><pose>0.187 0.08081109715734115 0.036 0 0 0</pose><geometry><sphere><radius>0.006</radius></sphere></geometry><material><diffuse>0.14 0.70 0.63 1</diffuse></material></visual>
  </link></model>
  <plugin name="gz::sim::systems::Deformables" filename="gz-sim-deformables-system">
    <box link="default::hit::ridge" coupling="one_way"/>
    <box link="default::miss::ridge" coupling="one_way"/>
    <cloth name="hit" columns="2" substeps="1" iterations="12" stretch="0" shear="0" bend="0" radius="0.006" self_contact="false" friction="0.25" conserve_angular_momentum="true">
      <particle position="-0.299 0 0.108" velocity="-0.21 2 -0.28" mass="0.025"/>
      <particle position="-0.107 0 -0.03599999999999999" velocity="-0.21 2 -0.28" mass="0.025"/>
      <particle position="-0.245 0 0.18" velocity="-0.21 2 -0.28" mass="0.025"/>
      <particle position="-0.05299999999999998 0 0.036" velocity="-0.21 2 -0.28" mass="0.025"/>
    </cloth>
    <particle_visual material="hit" particle="0" visual="default::hit::ridge::p0"/>
    <particle_visual material="hit" particle="1" visual="default::hit::ridge::p1"/>
    <particle_visual material="hit" particle="2" visual="default::hit::ridge::p2"/>
    <particle_visual material="hit" particle="3" visual="default::hit::ridge::p3"/>
    <cloth name="miss" columns="2" substeps="1" iterations="12" stretch="0" shear="0" bend="0" radius="0.006" self_contact="false" friction="0.25" conserve_angular_momentum="true">
      <particle position="0.181 0.08081109715734115 0.108" velocity="-0.21 2 -0.28" mass="0.025"/>
      <particle position="0.373 0.08081109715734115 -0.03599999999999999" velocity="-0.21 2 -0.28" mass="0.025"/>
      <particle position="0.235 0.08081109715734115 0.18" velocity="-0.21 2 -0.28" mass="0.025"/>
      <particle position="0.427 0.08081109715734115 0.036" velocity="-0.21 2 -0.28" mass="0.025"/>
    </cloth>
    <particle_visual material="miss" particle="0" visual="default::miss::ridge::p0"/>
    <particle_visual material="miss" particle="1" visual="default::miss::ridge::p1"/>
    <particle_visual material="miss" particle="2" visual="default::miss::ridge::p2"/>
    <particle_visual material="miss" particle="3" visual="default::miss::ridge::p3"/>
  </plugin>
</world></sdf>
