<sdf version="1.12">
  <world name="default">
    <gravity>0 0 -9.81</gravity>
    <physics name="clock" type="ode"><max_step_size>0.0005</max_step_size></physics>
    <plugin name="gz::sim::systems::DampedSole" filename="gz-sim-damped-sole-system">
      <foot>default::boot::sole</foot><support>default::deck::plate</support>
      <support>default::ledge::side</support>
      <upper_negative_x_support>default::ledge::side</upper_negative_x_support><upper_corner_stiffness>40000</upper_corner_stiffness>
      <foot_stiffness>2000000</foot_stiffness><deck_stiffness>3000000</deck_stiffness>
      <damping>2.5</damping><friction>0</friction><slip_speed>0.002</slip_speed>
      <substeps>8</substeps><quadrature_depth>1</quadrature_depth>
    </plugin>
    <model name="deck"><static>true</static><link name="plate"><pose>-0.085 0 -0.03 0 0 0</pose>
      <collision name="deck_shape"><geometry><box><size>0.75 0.85 0.06</size></box></geometry></collision>
      <visual name="deck"><geometry><box><size>0.75 0.85 0.06</size></box></geometry><material><diffuse>0.30 0.49 0.48 1</diffuse></material></visual>
    </link></model>
    <model name="ledge"><static>true</static><link name="side"><pose>0.350 0 0.16 0 0 0</pose>
      <collision name="wall"><geometry><box><size>0.10 0.45 0.32</size></box></geometry></collision>
      <visual name="wall"><geometry><box><size>0.10 0.45 0.32</size></box></geometry><material><diffuse>0.75 0.30 0.23 1</diffuse></material></visual>
    </link></model>
    <model name="boot"><pose>0 0 0.02477291666666667 0 0 0</pose>
      <plugin name="gz::sim::systems::InitialVelocity" filename="gz-sim-initial-velocity-system">
        <linear_velocity>0.65 0.20 0</linear_velocity><angular_velocity>0 0 0</angular_velocity>
      </plugin>
      <link name="sole">
        <inertial><pose>0 0 0 0 0 0</pose><mass>1</mass><inertia><ixx>0.012</ixx><iyy>0.016</iyy><izz>0.02</izz></inertia></inertial>
        <collision name="sole_shape"><geometry><box><size>0.36 0.20 0.05</size></box></geometry></collision>
        <visual name="sole"><geometry><box><size>0.36 0.20 0.05</size></box></geometry><material><diffuse>0.96 0.55 0.15 1</diffuse></material></visual>
      </link>
      <link name="upper"><pose>0 0 0.14 0 0.15 0.23</pose>
        <inertial><pose>0 0 0 0 0 0</pose><mass>1</mass><inertia><ixx>0.030</ixx><iyy>0.030</iyy><izz>0.030</izz></inertia></inertial>
        <collision name="upper_shape"><geometry><box><size>0.56 0.14 0.08</size></box></geometry></collision>
        <visual name="upper"><geometry><box><size>0.56 0.14 0.08</size></box></geometry><material><diffuse>0.19 0.36 0.65 1</diffuse></material></visual>
      </link>
      <joint name="weld" type="fixed"><parent>sole</parent><child>upper</child></joint>
    </model>
  </world>
</sdf>
