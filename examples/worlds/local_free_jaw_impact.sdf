<?xml version="1.0"?>
<!-- A free 200 g parcel approaches a free 80 g jaw across 50 micrometres. -->
<sdf version="1.12">
  <world name="default">
    <gravity>0 0 0</gravity>
    <physics name="local" type="ignored"><max_step_size>0.001</max_step_size></physics>
    <plugin name="gz::sim::systems::PrimaryContactRefinement" filename="gz-sim-primary-contact-refinement-system">
      <native_steps>64</native_steps><solver_iterations>8</solver_iterations><pgs_iterations>8</pgs_iterations>
      <early_face_step_ns>25</early_face_step_ns><early_face_max_steps>4096</early_face_max_steps>
      <pair><foot>default::parcel::body</foot><support>default::jaw::body</support><incoming_face>-x</incoming_face></pair>
    </plugin>
    <model name="parcel"><pose>-0.03905 0 0.1 0 0 0</pose>
      <plugin name="gz::sim::systems::InitialVelocity" filename="gz-sim-initial-velocity-system">
        <linear_velocity>0.75 0 0</linear_velocity><angular_velocity>0 0 0</angular_velocity>
      </plugin>
      <plugin name="gz::sim::systems::ContactMaterial" filename="gz-sim-contact-material-system">
        <restitution link="body">0</restitution>
      </plugin>
      <link name="body">
        <inertial><mass>0.2</mass><inertia><ixx>0.00013208333333333334</ixx><iyy>0.00014166666666666668</iyy><izz>0.00011041666666666667</izz></inertia></inertial>
        <collision name="box"><geometry><box><size>0.06 0.055 0.07</size></box></geometry>
          <surface><friction><ode><mu>0</mu><mu2>0</mu2></ode></friction></surface>
        </collision>
        <visual name="box"><geometry><box><size>0.06 0.055 0.07</size></box></geometry><material><diffuse>0.72 0.29 0.20 1</diffuse></material></visual>
      </link>
    </model>
    <model name="jaw"><pose>0 0 0.1 0 0 0</pose>
      <plugin name="gz::sim::systems::ContactMaterial" filename="gz-sim-contact-material-system">
        <restitution link="body">0</restitution>
      </plugin>
      <link name="body">
        <inertial><mass>0.08</mass><inertia><ixx>0.00009659333333333334</ixx><iyy>0.00006882666666666667</iyy><izz>0.00003208666666666667</izz></inertia></inertial>
        <collision name="box"><geometry><box><size>0.018 0.067 0.10</size></box></geometry>
          <surface><friction><ode><mu>0</mu><mu2>0</mu2></ode></friction></surface>
        </collision>
        <visual name="box"><geometry><box><size>0.018 0.067 0.10</size></box></geometry><material><diffuse>0.96 0.55 0.13 1</diffuse></material></visual>
      </link>
    </model>
  </world>
</sdf>
