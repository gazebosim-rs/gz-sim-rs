<?xml version="1.0"?>
<sdf version="1.12">
  <world name="default">
    <gravity>0 0 -9.81</gravity>
    <physics name="local" type="ignored"><max_step_size>0.001</max_step_size></physics>
    <model name="stand"><static>true</static>
      <link name="post"><pose>0 0 0.48 0 0 0</pose>
        <collision name="post"><geometry><box><size>0.65 0.65 0.04</size></box></geometry>
          <surface><friction><ode><mu>0.75</mu><mu2>0.75</mu2></ode></friction></surface>
        </collision>
        <visual name="post"><geometry><box><size>0.65 0.65 0.04</size></box></geometry><material><diffuse>0.36 0.43 0.50 1</diffuse></material></visual>
        <visual name="base"><pose>0 0 -0.245 0 0 0</pose><geometry><box><size>0.16 0.16 0.45</size></box></geometry><material><diffuse>0.22 0.27 0.33 1</diffuse></material></visual>
        <visual name="cable_0"><pose>0 -0.110 0.045 0 0 0</pose><geometry><sphere><radius>0.025</radius></sphere></geometry><material><diffuse>0.86 0.63 0.98 1</diffuse></material></visual>
        <visual name="cable_1"><pose>0 -0.088 0.045 0 0 0</pose><geometry><sphere><radius>0.025</radius></sphere></geometry><material><diffuse>0.86 0.63 0.98 1</diffuse></material></visual>
        <visual name="cable_2"><pose>0 -0.066 0.045 0 0 0</pose><geometry><sphere><radius>0.025</radius></sphere></geometry><material><diffuse>0.86 0.63 0.98 1</diffuse></material></visual>
