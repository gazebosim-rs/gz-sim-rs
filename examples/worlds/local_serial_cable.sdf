        <visual name="cable_4"><pose>0 -0.022 0.045 0 0 0</pose><geometry><sphere><radius>0.025</radius></sphere></geometry><material><diffuse>0.86 0.63 0.98 1</diffuse></material></visual>
        <visual name="cable_5"><pose>0 0.000 0.045 0 0 0</pose><geometry><sphere><radius>0.025</radius></sphere></geometry><material><diffuse>0.86 0.63 0.98 1</diffuse></material></visual>
        <visual name="cable_6"><pose>0 0.022 0.045 0 0 0</pose><geometry><sphere><radius>0.025</radius></sphere></geometry><material><diffuse>0.86 0.63 0.98 1</diffuse></material></visual>
        <visual name="cable_7"><pose>0 0.044 0.045 0 0 0</pose><geometry><sphere><radius>0.025</radius></sphere></geometry><material><diffuse>0.86 0.63 0.98 1</diffuse></material></visual>
        <visual name="cable_8"><pose>0 0.066 0.045 0 0 0</pose><geometry><sphere><radius>0.025</radius></sphere></geometry><material><diffuse>0.86 0.63 0.98 1</diffuse></material></visual>
        <visual name="cable_9"><pose>0 0.088 0.045 0 0 0</pose><geometry><sphere><radius>0.025</radius></sphere></geometry><material><diffuse>0.86 0.63 0.98 1</diffuse></material></visual>
        <visual name="cable_10"><pose>0 0.110 0.045 0 0 0</pose><geometry><sphere><radius>0.025</radius></sphere></geometry><material><diffuse>0.86 0.63 0.98 1</diffuse></material></visual>
      </link>
    </model>
    <model name="receiver"><static>true</static>
      <link name="shelf"><pose>0 0.46 0.574 0 0 0</pose>
        <collision name="top"><geometry><box><size>0.32 0.32 0.012</size></box></geometry></collision>
        <visual name="top"><geometry><box><size>0.32 0.32 0.012</size></box></geometry><material><diffuse>0.27 0.73 0.48 1</diffuse></material></visual>
        <visual name="leg"><pose>0 0 -0.28 0 0 0</pose><geometry><box><size>0.04 0.04 0.55</size></box></geometry><material><diffuse>0.23 0.42 0.34 1</diffuse></material></visual>
      </link>
    </model>
    <model name="overhead"><static>true</static><link name="rail">
      <collision name="beam"><pose>0 0.23 1.125 0 0 0</pose><geometry><box><size>0.035 0.64 0.025</size></box></geometry></collision>
      <visual name="beam"><pose>0 0.23 1.125 0 0 0</pose><geometry><box><size>0.035 0.64 0.025</size></box></geometry><material><diffuse>0.41 0.47 0.53 1</diffuse></material></visual>
    </link></model>
    <model name="gripper">
      <link name="carriage"><pose>0 0 1.085 0 0 0</pose>
        <inertial><mass>1.2</mass><inertia><ixx>0.003</ixx><iyy>0.003</iyy><izz>0.004</izz></inertia></inertial>
        <collision name="truck"><geometry><box><size>0.08 0.08 0.04</size></box></geometry></collision>
        <visual name="spindle_sleeve"><pose>0 0 -0.10 0 0 0</pose><geometry><box><size>0.036 0.036 0.20</size></box></geometry><material><diffuse>0.38 0.43 0.48 1</diffuse></material></visual>
        <visual name="truck"><geometry><box><size>0.08 0.08 0.04</size></box></geometry><material><diffuse>0.14 0.38 0.51 1</diffuse></material></visual>
      </link>
      <joint name="travel" type="prismatic"><parent>world</parent><child>carriage</child>
        <axis><xyz>0 1 0</xyz><limit><lower>-0.02</lower><upper>0.52</upper></limit></axis>
      </joint>

      <link name="nut"><pose>0 0 0.76 0 0 0</pose>
        <inertial><mass>0.7</mass><inertia><ixx>0.003</ixx><iyy>0.003</iyy><izz>0.0045</izz></inertia></inertial>
        <collision name="nut"><geometry><box><size>0.17 0.10 0.045</size></box></geometry>
          <surface><friction><ode><mu>0.7</mu><mu2>0.7</mu2></ode></friction></surface>
        </collision>
        <visual name="spindle_shaft"><pose>0 0 0.07 0 0 0</pose><geometry><box><size>0.018 0.018 0.14</size></box></geometry><material><diffuse>0.68 0.72 0.76 1</diffuse></material></visual>
        <visual name="nut"><geometry><box><size>0.17 0.10 0.045</size></box></geometry><material><diffuse>0.15 0.54 0.62 1</diffuse></material></visual>
        <visual name="index"><pose>0.065 0 0.028 0 0 0</pose><geometry><box><size>0.025 0.035 0.011</size></box></geometry><material><diffuse>0.93 0.7 0.25 1</diffuse></material></visual>
      </link>
      <link name="palm"><pose>0 0 0.695 0 0 0</pose>
        <inertial><mass>0.4</mass><inertia><ixx>0.0012</ixx><iyy>0.0016</iyy><izz>0.0018</izz></inertia></inertial>
        <collision name="palm"><geometry><box><size>0.175 0.095 0.035</size></box></geometry>
          <surface><friction><ode><mu>0.7</mu><mu2>0.7</mu2></ode></friction></surface>
        </collision>
        <visual name="palm"><geometry><box><size>0.175 0.095 0.035</size></box></geometry><material><diffuse>0.17 0.39 0.50 1</diffuse></material></visual>
      </link>
      <link name="left"><pose>-0.06 0 0.556 0 0 0</pose>
        <inertial><mass>0.08</mass><inertia><ixx>9.2e-05</ixx><iyy>7.2e-05</iyy><izz>2.9e-05</izz></inertia></inertial>
        <collision name="left"><geometry><box><size>0.018 0.067 0.10</size></box></geometry>
          <surface><friction><ode><mu>0.85</mu><mu2>0.85</mu2></ode></friction></surface>
        </collision>
        <visual name="left"><geometry><box><size>0.018 0.067 0.10</size></box></geometry><material><diffuse>0.96 0.55 0.13 1</diffuse></material></visual>
        <visual name="stalk"><pose>0 0 0.083 0 0 0</pose><geometry><box><size>0.016 0.023 0.086</size></box></geometry><material><diffuse>0.55 0.60 0.64 1</diffuse></material></visual>
      </link>
      <link name="right"><pose>0.06 0 0.556 0 0 0</pose>
        <inertial><mass>0.08</mass><inertia><ixx>9.2e-05</ixx><iyy>7.2e-05</iyy><izz>2.9e-05</izz></inertia></inertial>
        <collision name="right"><geometry><box><size>0.018 0.067 0.10</size></box></geometry>
          <surface><friction><ode><mu>0.85</mu><mu2>0.85</mu2></ode></friction></surface>
        </collision>
        <visual name="right"><geometry><box><size>0.018 0.067 0.10</size></box></geometry><material><diffuse>0.96 0.55 0.13 1</diffuse></material></visual>
        <visual name="stalk"><pose>0 0 0.083 0 0 0</pose><geometry><box><size>0.016 0.023 0.086</size></box></geometry><material><diffuse>0.55 0.60 0.64 1</diffuse></material></visual>
      </link>
      <joint name="spindle" type="screw"><parent>carriage</parent><child>nut</child>
        <screw_thread_pitch>0.50</screw_thread_pitch>
        <axis><xyz>0 0 1</xyz><limit><lower>-0.10</lower><upper>2.9</upper><velocity>0.8</velocity><effort>3.0</effort></limit></axis>
      </joint>
      <joint name="wrist" type="universal"><parent>nut</parent><child>palm</child><pose>0 0 0.04 0 0 0</pose>
        <axis><xyz>1 0 0</xyz><limit><lower>-0.45</lower><upper>0.45</upper></limit><dynamics><spring_stiffness>4</spring_stiffness><damping>0.4</damping></dynamics></axis>
        <axis2><xyz>0 1 0</xyz><limit><lower>-0.45</lower><upper>0.45</upper><velocity>0.6</velocity><effort>2</effort></limit></axis2>
      </joint>
      <joint name="close_left" type="prismatic"><parent>palm</parent><child>left</child>
        <axis><xyz>1 0 0</xyz><limit><lower>0</lower><upper>0.047</upper></limit>
          <dynamics><spring_reference>0.048</spring_reference><spring_stiffness>300</spring_stiffness><damping>8</damping></dynamics>
        </axis>
      </joint>
      <joint name="close_right" type="prismatic"><parent>palm</parent><child>right</child>
        <axis><xyz>-1 0 0</xyz><limit><lower>0</lower><upper>0.047</upper></limit>
          <dynamics><spring_reference>0.048</spring_reference><spring_stiffness>300</spring_stiffness><damping>8</damping></dynamics>
        </axis>
      </joint>
      <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
        <joint_name>spindle</joint_name><joint_index>0</joint_index><use_velocity_commands>true</use_velocity_commands>
        <initial_position>0</initial_position><cmd_max>0.65</cmd_max>
      </plugin>
      <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
        <joint_name>wrist</joint_name><joint_index>1</joint_index><use_velocity_commands>true</use_velocity_commands>
        <initial_position>0</initial_position><cmd_max>0.1</cmd_max>
      </plugin>
    </model>
    <model name="obstacle"><static>true</static>
      <link name="bar"><pose>0 0.23 0.5535 0 0 0</pose>
        <collision name="bar"><geometry><box><size>0.26 0.024 0.107</size></box></geometry></collision>
        <visual name="bar"><geometry><box><size>0.26 0.024 0.107</size></box></geometry><material><diffuse>0.88 0.24 0.12 1</diffuse></material></visual>
      </link>
    </model>
    <plugin name="gz::sim::systems::Deformables" filename="gz-sim-deformables-system">
      <box link="default::gripper::left" coupling="articulated_wrench" normal_compliance="0.001"/>
      <box link="default::gripper::right" coupling="articulated_wrench" normal_compliance="0.001"/>
      <box link="default::stand::post" coupling="one_way"/>
      <box link="default::receiver::shelf" coupling="one_way"/>
      <box link="default::obstacle::bar" coupling="one_way"/>
      <cable name="cable" substeps="2" iterations="8" radius="0.025" self_contact="false" friction="0.7" stretch="0.00001" bend="0.003">
        <particle position="0 -0.110 0.525" mass="0.002"/>
        <particle position="0 -0.088 0.525" mass="0.002"/>
        <particle position="0 -0.066 0.525" mass="0.002"/>
        <particle position="0 -0.044 0.525" mass="0.002"/>
        <particle position="0 -0.022 0.525" mass="0.002"/>
        <particle position="0 0.000 0.525" mass="0.002"/>
        <particle position="0 0.022 0.525" mass="0.002"/>
        <particle position="0 0.044 0.525" mass="0.002"/>
        <particle position="0 0.066 0.525" mass="0.002"/>
        <particle position="0 0.088 0.525" mass="0.002"/>
        <particle position="0 0.110 0.525" mass="0.002"/>
      </cable>
      <particle_visual material="cable" particle="0" visual="default::stand::post::cable_0"/>
      <particle_visual material="cable" particle="1" visual="default::stand::post::cable_1"/>
      <particle_visual material="cable" particle="2" visual="default::stand::post::cable_2"/>
      <particle_visual material="cable" particle="3" visual="default::stand::post::cable_3"/>
      <particle_visual material="cable" particle="4" visual="default::stand::post::cable_4"/>
      <particle_visual material="cable" particle="5" visual="default::stand::post::cable_5"/>
      <particle_visual material="cable" particle="6" visual="default::stand::post::cable_6"/>
      <particle_visual material="cable" particle="7" visual="default::stand::post::cable_7"/>
      <particle_visual material="cable" particle="8" visual="default::stand::post::cable_8"/>
      <particle_visual material="cable" particle="9" visual="default::stand::post::cable_9"/>
      <particle_visual material="cable" particle="10" visual="default::stand::post::cable_10"/>
    </plugin>
  </world>
</sdf>
