<sdf version="1.12"><world name="default">
  <gravity>0 0 -9.81</gravity>
  <physics name="two_ms" type="ignored"><max_step_size>0.002</max_step_size></physics>
  <model name="conveyor">
    <plugin name="gz::sim::systems::PrescribedMotion" filename="gz-sim-prescribed-motion-system">
      <linear_velocity>0.4 0 0</linear_velocity><angular_velocity>0 0 0</angular_velocity>
    </plugin>
    <link name="deck">
      <collision name="board"><pose>0.06 0 0.30 0 0 0</pose><geometry><box><size>0.60 0.36 0.04</size></box></geometry></collision>
      <visual name="board"><pose>0.06 0 0.30 0 0 0</pose><geometry><box><size>0.60 0.36 0.04</size></box></geometry><material><diffuse>0.30 0.42 0.54 1</diffuse></material></visual>
      <visual name="carried_0"><pose>-0.140 -0.080 0.328 0 0 0</pose><geometry><sphere><radius>0.008</radius></sphere></geometry><material><diffuse>0.12 0.8 0.52 1</diffuse></material></visual>
      <visual name="carried_1"><pose>-0.100 -0.080 0.328 0 0 0</pose><geometry><sphere><radius>0.008</radius></sphere></geometry><material><diffuse>0.12 0.8 0.52 1</diffuse></material></visual>
      <visual name="carried_2"><pose>-0.140 -0.035 0.328 0 0 0</pose><geometry><sphere><radius>0.008</radius></sphere></geometry><material><diffuse>0.12 0.8 0.52 1</diffuse></material></visual>
      <visual name="carried_3"><pose>-0.100 -0.035 0.328 0 0 0</pose><geometry><sphere><radius>0.008</radius></sphere></geometry><material><diffuse>0.12 0.8 0.52 1</diffuse></material></visual>
      <visual name="sliding_0"><pose>0.100 0.050 0.328 0 0 0</pose><geometry><sphere><radius>0.008</radius></sphere></geometry><material><diffuse>0.99 0.47 0.16 1</diffuse></material></visual>
      <visual name="sliding_1"><pose>0.140 0.050 0.328 0 0 0</pose><geometry><sphere><radius>0.008</radius></sphere></geometry><material><diffuse>0.99 0.47 0.16 1</diffuse></material></visual>
      <visual name="sliding_2"><pose>0.100 0.095 0.328 0 0 0</pose><geometry><sphere><radius>0.008</radius></sphere></geometry><material><diffuse>0.99 0.47 0.16 1</diffuse></material></visual>
      <visual name="sliding_3"><pose>0.140 0.095 0.328 0 0 0</pose><geometry><sphere><radius>0.008</radius></sphere></geometry><material><diffuse>0.99 0.47 0.16 1</diffuse></material></visual>
    </link>
  </model>
  <plugin name="gz::sim::systems::Deformables" filename="gz-sim-deformables-system">
    <box link="default::conveyor::deck" coupling="one_way"/>
    <cloth name="carried" columns="2" substeps="4" iterations="8" stretch="0.000001" shear="0.000001" bend="0.0001" radius="0.008" self_contact="false" friction="0.1" static_plane_friction="0.4">
      <particle position="-0.140 -0.080 0.328" velocity="0.4 0 0" mass="0.025"/>
      <particle position="-0.100 -0.080 0.328" velocity="0.4 0 0" mass="0.025"/>
      <particle position="-0.140 -0.035 0.328" velocity="0.4 0 0" mass="0.025"/>
      <particle position="-0.100 -0.035 0.328" velocity="0.4 0 0" mass="0.025"/>
    </cloth>
    <cloth name="sliding" columns="2" substeps="4" iterations="8" stretch="0.000001" shear="0.000001" bend="0.0001" radius="0.008" self_contact="false" friction="0.1" static_plane_friction="0.4">
      <particle position="0.100 0.050 0.328" velocity="1.65 0 0" mass="0.025"/>
      <particle position="0.140 0.050 0.328" velocity="1.65 0 0" mass="0.025"/>
      <particle position="0.100 0.095 0.328" velocity="1.65 0 0" mass="0.025"/>
      <particle position="0.140 0.095 0.328" velocity="1.65 0 0" mass="0.025"/>
    </cloth>
    <particle_visual material="carried" particle="0" visual="default::conveyor::deck::carried_0"/>
    <particle_visual material="carried" particle="1" visual="default::conveyor::deck::carried_1"/>
    <particle_visual material="carried" particle="2" visual="default::conveyor::deck::carried_2"/>
    <particle_visual material="carried" particle="3" visual="default::conveyor::deck::carried_3"/>
    <particle_visual material="sliding" particle="0" visual="default::conveyor::deck::sliding_0"/>
    <particle_visual material="sliding" particle="1" visual="default::conveyor::deck::sliding_1"/>
    <particle_visual material="sliding" particle="2" visual="default::conveyor::deck::sliding_2"/>
    <particle_visual material="sliding" particle="3" visual="default::conveyor::deck::sliding_3"/>
  </plugin>
</world></sdf>
