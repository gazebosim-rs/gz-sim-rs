<?xml version="1.0" ?>
<!-- A spinning, asymmetric free rigid foot meets an inclined moving pad. -->
<sdf version="1.12">
  <world name="default">
    <gravity>0 0 0</gravity>
    <physics name="fixed" type="ignored">
      <max_step_size>0.0005</max_step_size>
    </physics>
    <plugin name="gz::sim::systems::PrimaryContactRefinement" filename="gz-sim-primary-contact-refinement-system">
      <native_steps>8</native_steps>
      <solver_iterations>4</solver_iterations>
      <pgs_iterations>1</pgs_iterations>
      <relaxation_iterations>16</relaxation_iterations>
      <pair>
        <foot>default::rocker::foot</foot>
        <support>default::lift::pad</support>
        <refresh_box_features>true</refresh_box_features>
        <prospective_timing>true</prospective_timing>
        <guard_separated_flight>true</guard_separated_flight>
      </pair>
    </plugin>
    <model name="lift">
      <pose>0.006967969011621796 -0.006471333407704878 -0.05924161756552059 -0.06415359999999998 -0.14576131687242794 -0.3320312499999999</pose>
      <plugin name="gz::sim::systems::PrescribedMotion" filename="gz-sim-prescribed-motion-system">
        <linear_velocity>-0.04830723639908366 0.18389966530952143 0.31307169959491943</linear_velocity>
        <angular_velocity>0 0 0</angular_velocity>
      </plugin>
      <link name="pad">
        <pose>0 0 0 0 0 0</pose>
        <collision name="contact">
          <geometry>
            <box>
              <size>0.66 0.36 0.12</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>0</mu>
                <mu2>0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.66 0.36 0.12</size>
            </box>
          </geometry>
        </visual>
      </link>
    </model>
    <model name="rocker">
      <pose>-0.02886093797649388 -0.008116646999116968 0.11689447821286378 -0.4273049731633123 -0.027066429643614186 -0.31863582619210146</pose>
      <plugin name="gz::sim::systems::InitialVelocity" filename="gz-sim-initial-velocity-system">
        <linear_velocity>0.09464100576255871 0.01632761508308897 -0.32819893174719217</linear_velocity>
        <angular_velocity>56.16665198913479 20.439818183534207 36.814639943038024</angular_velocity>
      </plugin>
      <link name="foot">
        <pose>0 0 0 0 0 0</pose>
        <inertial>
          <pose>0 0 0.07 0 -0 0</pose>
          <mass>2</mass>
          <inertia>
            <ixx>0.04253922034413734</ixx>
            <iyy>0.06304891895921749</iyy>
            <izz>0.04801186069664515</izz>
            <ixy>0.008111711604184935</ixy>
            <ixz>-0.012542213255261243</ixz>
            <iyz>0.012987366099383123</iyz>
          </inertia>
        </inertial>
        <collision name="contact">
          <geometry>
            <box>
              <size>0.36 0.2 0.12</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>0</mu>
                <mu2>0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.36 0.2 0.12</size>
            </box>
          </geometry>
        </visual>
      </link>
    </model>
  </world>
</sdf>
