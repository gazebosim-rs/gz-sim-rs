<?xml version="1.0"?>
<!-- A yawing foot spans two finite, independently translating frictionless supports. -->
<sdf version="1.12">
  <world name="default">
    <gravity>0.13000000000000000 -0.08000000000000000 -9.81000000000000050</gravity>
    <physics name="fixed" type="ignored"><max_step_size>0.0005</max_step_size><real_time_factor>1</real_time_factor></physics>

    <model name="rocker">
      <pose>-0.12000000000000000 -0.05500000000000000 0.06000000000000000 0.00000000000000000 0.00000000000000000 -0.31000000000000000</pose>
      <plugin name="gz::sim::systems::InitialVelocity" filename="gz-sim-initial-velocity-system">
        <linear_velocity>0.93000000000000005 0.05000000000000002 0.22000000000000000</linear_velocity><angular_velocity>0.00000000000000000 0.00000000000000000 0.00000000000000000</angular_velocity>
      </plugin>
      <plugin name="gz::sim::systems::SwitchableArticulation" filename="gz-sim-switchable-articulation-system">
        <exact_revolute_locks>true</exact_revolute_locks>
      </plugin>
      <link name="foot">
        <inertial><mass>1.00000000000000000</mass><inertia><ixx>0.01610000000000000</ixx><iyy>0.02160000000000000</iyy><izz>0.02950000000000000</izz><ixy>0.00100000000000000</ixy><ixz>-0.00400000000000000</ixz><iyz>0.00300000000000000</iyz></inertia></inertial>
        <collision name="sole"><geometry><box><size>0.36 0.20 0.12</size></box></geometry><surface><friction><ode><mu>1</mu><mu2>1</mu2></ode></friction></surface></collision>
        <visual name="sole"><geometry><box><size>0.36 0.20 0.12</size></box></geometry><material><diffuse>0.92 0.46 0.12 1</diffuse></material></visual>
      </link>
      <link name="upper">
        <pose>0 0 0.14 0 0 0</pose>
        <inertial><mass>1.00000000000000000</mass><inertia><ixx>0.01610000000000000</ixx><iyy>0.02160000000000000</iyy><izz>0.02950000000000000</izz><ixy>0.00100000000000000</ixy><ixz>-0.00400000000000000</ixz><iyz>0.00300000000000000</iyz></inertia></inertial>
        <collision name="c"><geometry><box><size>0.10 0.12 0.12</size></box></geometry><surface><friction><ode><mu>1</mu><mu2>1</mu2></ode></friction></surface></collision>
        <visual name="v"><geometry><box><size>0.10 0.12 0.12</size></box></geometry><material><diffuse>0.90 0.73 0.21 1</diffuse></material></visual>
      </link>
      <joint name="hinge" type="revolute">
        <parent>foot</parent><child>upper</child>
        <axis><xyz>1 0 0</xyz><limit><lower>0</lower><upper>0</upper></limit></axis>
      </joint>
    </model>
    <model name="lift"><pose>-0.13000000000000000 -0.00900000000000000 -0.06000000000000000 0.00000000000000000 0.00000000000000000 -0.20000000000000001</pose>
      <plugin name="gz::sim::systems::PrescribedMotion" filename="gz-sim-prescribed-motion-system"><linear_velocity>-0.23000000000000001 0.10000000000000001 0.22000000000000000</linear_velocity><angular_velocity>0 0 0</angular_velocity></plugin>
      <link name="pad"><collision name="platform"><geometry><box><size>0.20999999999999999 0.28399999999999997 0.12</size></box></geometry><surface><friction><ode><mu>0.22</mu><mu2>0.22</mu2></ode></friction></surface></collision><visual name="platform"><geometry><box><size>0.20999999999999999 0.28399999999999997 0.12</size></box></geometry><material><diffuse>0.28 0.57 0.30 1</diffuse></material></visual></link></model>
    <model name="toe"><pose>0.14000000000000001 0.02500000000000000 -0.06000000000000000 0.00000000000000000 -0.00000000000000000 0.13999999999999996</pose>
      <plugin name="gz::sim::systems::PrescribedMotion" filename="gz-sim-prescribed-motion-system"><linear_velocity>1.86999999999999988 -0.40000000000000002 0.22000000000000000</linear_velocity><angular_velocity>0 0 0</angular_velocity></plugin>
      <link name="pad"><collision name="platform"><geometry><box><size>0.23000000000000001 0.27000000000000002 0.12</size></box></geometry><surface><friction><ode><mu>0.44</mu><mu2>0.44</mu2></ode></friction></surface></collision><visual name="platform"><geometry><box><size>0.23000000000000001 0.27000000000000002 0.12</size></box></geometry><material><diffuse>0.15 0.40 0.75 1</diffuse></material></visual></link></model>
  </world>
</sdf>
