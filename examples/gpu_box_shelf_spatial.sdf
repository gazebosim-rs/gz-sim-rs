<?xml version="1.0"?>
<sdf version="1.12">
  <world name="default">
    <gravity>0 0 -9.81</gravity>
    <physics name="local" type="ignored"><max_step_size>0.001</max_step_size><real_time_factor>1</real_time_factor></physics>
    <plugin name="gz::sim::systems::GpuBatch" filename="gz-sim-gpu-batch-system">
      <environment id="12" profile="carrying-gripper" track="track" shelf="shelf::top" model="gripper" object="parcel" plane="table::base" lift="lift" left="left_slider" right="right_slider">
        <drive joint="lift" stiffness="270" damping="23" target="0"/>
        <drive joint="left_slider" stiffness="1100" damping="16" target="0.028"/>
        <drive joint="right_slider" stiffness="1100" damping="16" target="-0.028"/>
        <track-drive stiffness="175" damping="23" target="0"/>
        <move tick="201" track="0" lift="0.10"/>
        <move tick="751" track="0.18" lift="0.10"/>
        <move tick="1751" track="0.18" lift="0.10" after_release="true"/>
        <move tick="2801" track="0" lift="0.10" after_release="true"/>
        <box-flight shelf_manifold="spatial-support" shelf_restitution="0" open_tick="2001" impulse_tick="2041" impulse="0.008 0 0" point="0.005 -0.008 -0.002"/>
        <release after="2501" dwell="24" weight_fraction="0.65" max_weight_fraction="1.4" max_speed="0.025" max_gap="0.0008" left="0" right="0"/>
      </environment>
    </plugin>
    <model name="table"><static>true</static><link name="base">
      <collision name="plane"><geometry><plane><normal>0 0 1</normal><size>2 2</size></plane></geometry><surface><friction><ode><mu>0.3</mu><mu2>0.3</mu2></ode></friction></surface></collision>
      <visual name="surface"><pose>0.13 0 -0.009 0 0 0</pose><geometry><box><size>0.49 0.15 0.018</size></box></geometry><material><diffuse>0.34 0.41 0.46 1</diffuse></material></visual>
      <visual name="track_guide"><pose>0.105 0 0.263 0 0 0</pose><geometry><box><size>0.35 0.026 0.008</size></box></geometry><material><diffuse>0.45 0.49 0.53 1</diffuse></material></visual>
    </link></model>
    <model name="shelf"><static>true</static><link name="top"><pose>0.18 0 0.007 0 0 0</pose>
      <collision name="receiving_surface"><geometry><box><size>0.12 0.21 0.014</size></box></geometry><surface><friction><ode><mu>0.45</mu><mu2>0.45</mu2></ode></friction></surface></collision>
      <visual name="surface"><geometry><box><size>0.12 0.21 0.014</size></box></geometry><material><diffuse>0.22 0.77 0.37 1</diffuse></material></visual>
    </link></model>
    <model name="gripper">
      <link name="rail"><pose>0 0 0.25 0 0 0</pose>
        <inertial><mass>0.3</mass><inertia><ixx>0.0001</ixx><iyy>0.0001</iyy><izz>0.0001</izz></inertia></inertial>
        <visual name="cart"><geometry><box><size>0.048 0.040 0.016</size></box></geometry><material><diffuse>0.2 0.43 0.81 1</diffuse></material></visual>
        <visual name="guide"><pose>0 0 -0.073 0 0 0</pose><geometry><box><size>0.008 0.010 0.145</size></box></geometry><material><diffuse>0.5 0.55 0.60 1</diffuse></material></visual>
      </link>
      <joint name="track" type="prismatic"><parent>world</parent><child>rail</child><axis><xyz>1 0 0</xyz><limit><lower>-0.05</lower><upper>0.28</upper><effort>16</effort></limit></axis></joint>
      <link name="carriage"><pose>0 0 0.11 0 0 0</pose>
        <inertial><mass>0.38</mass><inertia><ixx>0.0001</ixx><iyy>0.0001</iyy><izz>0.0001</izz></inertia></inertial>
        <visual name="rail"><geometry><box><size>0.15 0.035 0.015</size></box></geometry><material><diffuse>0.10 0.68 0.75 1</diffuse></material></visual>
      </link>
      <link name="left"><pose>-0.05 0 0.03 0 0 0</pose>
        <inertial><mass>0.12</mass><inertia><ixx>.0001</ixx><iyy>.0001</iyy><izz>.0001</izz></inertia></inertial>
        <collision name="pad"><geometry><box><size>.012 .064 .022</size></box></geometry><surface><friction><ode><mu>0.6</mu><mu2>0.6</mu2></ode></friction></surface></collision>
        <visual name="pad"><geometry><box><size>.012 .064 .022</size></box></geometry><material><diffuse>0.98 0.58 0.13 1</diffuse></material></visual>
        <visual name="stem"><pose>0 0 0.044 0 0 0</pose><geometry><box><size>.008 .016 .061</size></box></geometry><material><diffuse>0.62 0.71 0.76 1</diffuse></material></visual>
      </link>
      <link name="right"><pose>0.05 0 0.03 0 0 0</pose>
        <inertial><mass>0.12</mass><inertia><ixx>.0001</ixx><iyy>.0001</iyy><izz>.0001</izz></inertia></inertial>
        <collision name="pad"><geometry><box><size>.012 .064 .022</size></box></geometry><surface><friction><ode><mu>0.6</mu><mu2>0.6</mu2></ode></friction></surface></collision>
        <visual name="pad"><geometry><box><size>.012 .064 .022</size></box></geometry><material><diffuse>0.98 0.58 0.13 1</diffuse></material></visual>
        <visual name="stem"><pose>0 0 0.044 0 0 0</pose><geometry><box><size>.008 .016 .061</size></box></geometry><material><diffuse>0.62 0.71 0.76 1</diffuse></material></visual>
      </link>
      <joint name="lift" type="prismatic"><parent>rail</parent><child>carriage</child>
        <axis><xyz>0 0 1</xyz><limit><lower>-0.003</lower><upper>0.19</upper><effort>25</effort></limit></axis></joint>
      <joint name="left_slider" type="prismatic"><parent>carriage</parent><child>left</child>
        <axis><xyz>1 0 0</xyz><limit><lower>-0.02</lower><upper>0.035</upper><effort>9</effort></limit></axis></joint>
      <joint name="right_slider" type="prismatic"><parent>carriage</parent><child>right</child>
        <axis><xyz>1 0 0</xyz><limit><lower>-0.035</lower><upper>0.02</upper><effort>9</effort></limit></axis></joint>
      <plugin name="gz::sim::systems::JointStatePublisher" filename="gz-sim-joint-state-publisher-system"><joint_name>track</joint_name><joint_name>lift</joint_name><joint_name>left_slider</joint_name><joint_name>right_slider</joint_name></plugin>
    </model>
    <model name="parcel"><pose>0 0 0.020 0 0 0</pose><link name="ball">
      <inertial><pose>0.005 0 -0.002 0 0 0</pose><mass>0.08</mass><inertia><ixx>0.00001450666666666667</ixx><iyy>0.00002602666666666667</iyy><izz>0.0000192</izz></inertia></inertial>
      <collision name="box"><geometry><box><size>0.048 0.024 0.040</size></box></geometry><surface><friction><ode><mu>1</mu><mu2>1</mu2></ode></friction></surface></collision>
      <visual name="box"><geometry><box><size>0.048 0.024 0.040</size></box></geometry><material><diffuse>0.84 0.16 0.40 1</diffuse></material></visual>
      <visual name="marker"><pose>0.014 0.015 0 0 0 0</pose><geometry><sphere><radius>0.005</radius></sphere></geometry><material><diffuse>1 0.95 0.12 1</diffuse></material></visual>
    </link></model>
  </world>
</sdf>
