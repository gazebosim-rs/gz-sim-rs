<sdf version="1.12"><world name="default">
  <gravity>0 0 0</gravity>
  <physics name="default" type="ignored"><max_step_size>0.001</max_step_size></physics>
  <model name="ground"><static>true</static><pose>0 0 -0.1 0 0 0</pose><link name="body">
    <collision name="ground"><geometry><box><size>6 6 0.2</size></box></geometry></collision>
    <visual name="ground"><geometry><box><size>6 6 0.2</size></box></geometry><material><diffuse>0.45 0.45 0.45 1</diffuse></material></visual>
  </link></model>
  <model name="arm" canonical_link="base"><pose>0 0 1 0 0 0</pose>
    <link name="base">
      <inertial><mass>1</mass><inertia><ixx>0.003266666666666667</ixx><iyy>0.08496666666666667</iyy><izz>0.08496666666666667</izz></inertia></inertial>
      <collision name="bar"><geometry><box><size>1 0.14 0.14</size></box></geometry></collision>
      <visual name="bar"><geometry><box><size>1 0.14 0.14</size></box></geometry><material><diffuse>0.8 0.5 0.15 1</diffuse></material></visual>
    </link>
    <link name="tip"><pose>0.8 0 0 0 0 0</pose>
      <inertial><mass>0.5</mass><inertia><ixx>0.0012</ixx><iyy>0.0156</iyy><izz>0.0156</izz></inertia></inertial>
      <collision name="bar"><geometry><box><size>0.6 0.12 0.12</size></box></geometry></collision>
      <visual name="bar"><geometry><box><size>0.6 0.12 0.12</size></box></geometry><material><diffuse>0.15 0.3 0.8 1</diffuse></material></visual>
    </link>
    <joint name="base_hinge" type="revolute"><parent>world</parent><child>base</child><pose relative_to="base">0 0 0 0 0 0</pose><axis><xyz>0 0 1</xyz><limit><effort>3</effort><velocity>4</velocity></limit></axis></joint>
    <joint name="tip_hinge" type="revolute"><parent>base</parent><child>tip</child><pose relative_to="tip">0 0 0 0 0 0</pose><axis><xyz>0 0 1</xyz><limit><effort>3</effort><velocity>4</velocity></limit></axis></joint>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>base_hinge</joint_name><joint_index>0</joint_index><use_velocity_commands>true</use_velocity_commands><cmd_max>2</cmd_max><initial_position>0</initial_position>
    </plugin>
    <plugin filename="gz-sim-joint-controller-system" name="gz::sim::systems::JointController">
      <joint_name>tip_hinge</joint_name><use_force_commands>false</use_force_commands><initial_velocity>0</initial_velocity>
    </plugin>
  </model>
</world></sdf>
