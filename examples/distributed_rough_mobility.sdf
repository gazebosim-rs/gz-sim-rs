<sdf version="1.12">
  <world name="default">
    <gravity>0 0 -9.81</gravity>
    <physics name="finite_rough_contact" type="ode"><max_step_size>0.002</max_step_size></physics>
    <model name="m1_table">
      <pose>0 0 -0.2 0 0 0</pose>
      <link name="link">
        <inertial><mass>10</mass><inertia><ixx>3.466666666666667</ixx><iyy>83.46666666666667</iyy><izz>86.66666666666667</izz></inertia></inertial>
        <collision name="surface"><geometry><box><size>10 2 0.4</size></box></geometry><surface><friction><ode><mu>0.65</mu><mu2>0.65</mu2></ode></friction></surface></collision>
        <visual name="table"><geometry><box><size>10 2 0.4</size></box></geometry><material><diffuse>0.24 0.39 0.56 1</diffuse></material></visual>
      </link>
      <plugin filename="gz-sim-prescribed-motion-system" name="gz::sim::systems::PrescribedMotion"><linear_velocity>0 0 0</linear_velocity><angular_velocity>0 0 0</angular_velocity></plugin>
    </model>
    <model name="m2_sphere">
      <pose>0 0 0.35 0 0 0</pose>
      <link name="link">
        <inertial><mass>2</mass><inertia><ixx>0.072</ixx><iyy>0.072</iyy><izz>0.072</izz></inertia></inertial>
        <collision name="surface"><geometry><sphere><radius>0.3</radius></sphere></geometry><surface><friction><ode><mu>0.35</mu><mu2>0.35</mu2></ode></friction></surface></collision>
        <visual name="sphere"><geometry><sphere><radius>0.3</radius></sphere></geometry><material><diffuse>0.93 0.43 0.18 1</diffuse></material></visual>
      </link>
    </model>
  </world>
</sdf>
