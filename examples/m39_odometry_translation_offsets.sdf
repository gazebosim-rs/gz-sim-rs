<sdf version="1.12">
  <world name="default">
    <gravity>0 0 0</gravity>
    <physics name="one_ms" type="ignored"><max_step_size>0.001</max_step_size></physics>
    <plugin name="gz::sim::systems::ApplyLinkWrench" filename="gz-sim-apply-link-wrench-system"/>
    <model name="rig">
      <pose>2 -1 3 0.2 0.3 0.6</pose>
      <link name="body">
        <inertial><mass>2</mass><inertia><ixx>1</ixx><iyy>1</iyy><izz>1</izz></inertia></inertial>
        <collision name="box"><geometry><box><size>0.2 0.2 0.2</size></box></geometry></collision>
        <visual name="box"><geometry><box><size>0.2 0.2 0.2</size></box></geometry></visual>
      </link>
      <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
        <dimensions>3</dimensions>
        <xyz_offset>0.4 -0.3 0.2</xyz_offset>
        <xyz_global_offset>-0.7 0.5 -0.6</xyz_global_offset><odom_publish_frequency>50</odom_publish_frequency>
        <odom_topic>/m39/odometry</odom_topic>
        <odom_covariance_topic>/m39/odometry_covariance</odom_covariance_topic>
        <tf_topic>/m39/transform</tf_topic>
        <odom_frame>m39/odom</odom_frame><robot_base_frame>m39/base</robot_base_frame>
      </plugin>
    </model>
  </world>
</sdf>
