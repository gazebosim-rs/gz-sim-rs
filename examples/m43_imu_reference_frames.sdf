<sdf version="1.12">
  <world name="default">
    <gravity>0 0 0</gravity>
    <physics name="step" type="ignored"><max_step_size>0.001</max_step_size></physics>
    <model name="rig">
      <pose>2 -1 3 0.2 0.3 0.6</pose>
      <link name="body">
        <inertial><mass>2</mass><inertia><ixx>1</ixx><iyy>1</iyy><izz>1</izz></inertia></inertial>
        <collision name="box"><geometry><box><size>0.2 0.2 0.2</size></box></geometry></collision>
        <visual name="box"><geometry><box><size>0.2 0.2 0.2</size></box></geometry></visual>
        <sensor name="imu" type="imu">
          <pose>0 0 0 0.1 -0.2 0.3</pose>
          <always_on>true</always_on><update_rate>100</update_rate>
          <topic>/m43/imu</topic><frame_id>rig/body/imu</frame_id>
          <imu><orientation_reference_frame><localization>NED</localization></orientation_reference_frame></imu>
        </sensor>
      </link>
    </model>
  </world>
</sdf>
