<sdf version="1.12">
  <world name="default">
    <gravity>0 0 0</gravity>
    <physics name="native" type="ignored"><max_step_size>0.011</max_step_size></physics>
    <model name="rotor">
      <plugin filename="gz-sim-initial-velocity-system" name="gz::sim::systems::InitialVelocity">
        <linear_velocity>0 1.8 0</linear_velocity><angular_velocity>0 0 4</angular_velocity>
      </plugin>
      <link name="pad">
        <pose>0.45 0 0.62 0 0 0</pose>
        <inertial><mass>1.2</mass><inertia><ixx>0.028</ixx><iyy>0.036</iyy><izz>0.032</izz></inertia></inertial>
        <collision name="pad_collider"><geometry><sphere><radius>0.035</radius></sphere></geometry></collision>
        <visual name="spherical_pad"><geometry><sphere><radius>0.035</radius></sphere></geometry><material><diffuse>0.13 0.63 0.85 1</diffuse></material></visual>
        <visual name="arm"><pose>-0.225 0 0 0 0 0</pose><geometry><box><size>0.45 0.025 0.025</size></box></geometry><material><diffuse>0.14 0.29 0.54 1</diffuse></material></visual>
        <visual name="cloth_corner_0"><geometry><sphere><radius>0.018</radius></sphere></geometry><material><diffuse>0.96 0.63 0.14 1</diffuse></material></visual>
        <visual name="cloth_corner_1"><geometry><sphere><radius>0.018</radius></sphere></geometry><material><diffuse>0.96 0.63 0.14 1</diffuse></material></visual>
        <visual name="cloth_corner_2"><geometry><sphere><radius>0.018</radius></sphere></geometry><material><diffuse>0.96 0.63 0.14 1</diffuse></material></visual>
        <visual name="cloth_corner_3"><geometry><sphere><radius>0.018</radius></sphere></geometry><material><diffuse>0.96 0.63 0.14 1</diffuse></material></visual>
      </link>
      <joint name="pivot" type="revolute">
        <parent>world</parent><child>pad</child><pose relative_to="pad">-0.45 0 0 0 0 0</pose>
        <axis><xyz expressed_in="__model__">0 0 1</xyz><limit><lower>-100</lower><upper>100</upper></limit></axis>
      </joint>
    </model>
    <plugin filename="gz-sim-deformables-system" name="gz::sim::systems::Deformables">
      <cloth name="material" columns="2" shear="0.003" substeps="3" iterations="8" radius="0.005" self_contact="false" friction="0" stretch="0.002" bend="0.005" conserve_angular_momentum="true">
        <particle position="0.14 0.32 0.53" velocity="0.08 -0.12 0.035" mass="0.17"/>
        <particle position="0.68 0.32 0.53" velocity="0.08 -0.12 0.035" mass="0.09"/>
        <particle position="0.14 0.32 1.16" velocity="0.08 -0.12 0.035" mass="0.26"/>
        <particle position="0.68 0.32 1.16" velocity="0.08 -0.12 0.035" mass="0.14"/>
      </cloth>
      <articulated_impact material="material" detection="first_impact" restitution="0.55"><sphere link="default::rotor::pad"/></articulated_impact>
      <particle_visual material="material" particle="0" visual="default::rotor::pad::cloth_corner_0"/>
      <particle_visual material="material" particle="1" visual="default::rotor::pad::cloth_corner_1"/>
      <particle_visual material="material" particle="2" visual="default::rotor::pad::cloth_corner_2"/>
      <particle_visual material="material" particle="3" visual="default::rotor::pad::cloth_corner_3"/>
    </plugin>
  </world>
</sdf>
