      </plugin>
      <plugin name="gz::sim::systems::SwitchableArticulation" filename="gz-sim-switchable-articulation-system">
        <exact_revolute_locks>true</exact_revolute_locks>
      </plugin>
      <link name="foot">
        <inertial><mass>1.00000000000000000</mass><inertia><ixx>0.01610000000000000</ixx><iyy>0.02160000000000000</iyy><izz>0.02950000000000000</izz><ixy>0.00100000000000000</ixy><ixz>-0.00400000000000000</ixz><iyz>0.00300000000000000</iyz></inertia></inertial>
        <collision name="sole"><geometry><box><size>0.36 0.20 0.12</size></box></geometry><surface><friction><ode><mu>0.31</mu><mu2>0.31</mu2></ode></friction></surface></collision>
        <visual name="sole"><geometry><box><size>0.36 0.20 0.12</size></box></geometry><material><diffuse>0.92 0.46 0.12 1</diffuse></material></visual>
      </link>
      <link name="upper">
