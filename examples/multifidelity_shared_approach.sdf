<?xml version="1.0"?>
<!-- A stationary locked foot rests across two finite pads under locally normal gravity. -->
<sdf version="1.12">
  <world name="default">
    <gravity>1.75628011530733530 2.20032657903627182 -9.39734766315275927</gravity>
    <physics name="fixed" type="ignored"><max_step_size>0.0005</max_step_size><real_time_factor>1</real_time_factor></physics>

    <plugin name="gz::sim::systems::PrimaryContactRefinement" filename="gz-sim-primary-contact-refinement-system"><native_steps>8</native_steps><solver_iterations>4</solver_iterations><pair><foot>default::rocker_0::foot</foot><support>default::lift_0::pad</support><follow_frictionless_face>true</follow_frictionless_face><share_coplanar_face>true</share_coplanar_face><share_uniform_sliding>true</share_uniform_sliding><settle_comoving_supports>true</settle_comoving_supports></pair><pair><foot>default::rocker_0::foot</foot><support>default::toe_0::pad</support><follow_frictionless_face>true</follow_frictionless_face><share_coplanar_face>true</share_coplanar_face><share_uniform_sliding>true</share_uniform_sliding><settle_comoving_supports>true</settle_comoving_supports></pair><pair><foot>default::rocker_1::foot</foot><support>default::lift_1::pad</support><follow_frictionless_face>true</follow_frictionless_face><share_coplanar_face>true</share_coplanar_face><share_uniform_sliding>true</share_uniform_sliding><settle_comoving_supports>true</settle_comoving_supports></pair><pair><foot>default::rocker_1::foot</foot><support>default::toe_1::pad</support><follow_frictionless_face>true</follow_frictionless_face><share_coplanar_face>true</share_coplanar_face><share_uniform_sliding>true</share_uniform_sliding><settle_comoving_supports>true</settle_comoving_supports></pair></plugin>
<model name="rocker_0">
      <pose>1.38925822559445056 -1.90177365817758837 0.63021186277876939 0.17423160799951687 -0.23436669157345891 0.24859036231090681</pose>
