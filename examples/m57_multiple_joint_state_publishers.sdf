<!-- Two passive articulated models publish independent joint selections and rates. -->
<sdf version="1.12">
  <world name="default">
    <gravity>0 0 -9.81</gravity>
    <physics name="default" type="ignored">
      <max_step_size>0.001</max_step_size>
    </physics>
    <model name="arm0" canonical_link="base">
      <pose>-1.4 0 1 0 0 0</pose>
      <link name="base">
        <inertial>
          <mass>1</mass>
          <inertia>
            <ixx>0.003266666666666667</ixx>
            <iyy>0.08496666666666667</iyy>
            <izz>0.08496666666666667</izz>
          </inertia>
        </inertial>
        <collision name="bar">
          <geometry>
            <box>
              <size>1 0.14 0.14</size>
            </box>
          </geometry>
        </collision>
        <visual name="bar">
          <geometry>
            <box>
              <size>1 0.14 0.14</size>
            </box>
          </geometry>
          <material>
            <diffuse>0.8 0.5 0.15 1</diffuse>
          </material>
        </visual>
      </link>
      <link name="tip">
        <pose>0.8 0 0 0 0 0</pose>
        <inertial>
          <mass>0.5</mass>
          <inertia>
            <ixx>0.0012</ixx>
            <iyy>0.0156</iyy>
            <izz>0.0156</izz>
          </inertia>
        </inertial>
        <collision name="bar">
          <geometry>
            <box>
              <size>0.6 0.12 0.12</size>
            </box>
          </geometry>
        </collision>
        <visual name="bar">
          <geometry>
            <box>
              <size>0.6 0.12 0.12</size>
            </box>
          </geometry>
          <material>
            <diffuse>0.15 0.3 0.8 1</diffuse>
          </material>
        </visual>
      </link>
      <joint name="base_hinge" type="revolute">
        <parent>world</parent>
        <child>base</child>
        <pose relative_to="base">0 0 0 0 0 0</pose>
        <axis>
          <xyz>0 1 0</xyz>
        </axis>
      </joint>
      <joint name="tip_hinge" type="revolute">
        <parent>base</parent>
        <child>tip</child>
        <pose relative_to="tip">0 0 0 0 0 0</pose>
        <axis>
          <xyz>0 1 0</xyz>
        </axis>
      </joint>
      <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
        <topic>/m57/joint0</topic>
        <update_rate>100</update_rate>
        <joint_name>base_hinge</joint_name>
        <joint_name>tip_hinge</joint_name>
      </plugin>
    </model>
    <model name="arm1" canonical_link="base">
      <pose>1.4 0 1 0 0 0</pose>
      <link name="base">
        <inertial>
          <mass>1</mass>
          <inertia>
            <ixx>0.003266666666666667</ixx>
            <iyy>0.08496666666666667</iyy>
            <izz>0.08496666666666667</izz>
          </inertia>
        </inertial>
        <collision name="bar">
          <geometry>
            <box>
              <size>1 0.14 0.14</size>
            </box>
          </geometry>
        </collision>
        <visual name="bar">
          <geometry>
            <box>
              <size>1 0.14 0.14</size>
            </box>
          </geometry>
          <material>
            <diffuse>0.8 0.5 0.15 1</diffuse>
          </material>
        </visual>
      </link>
      <link name="tip">
        <pose>0.8 0 0 0 0 0</pose>
        <inertial>
          <mass>0.5</mass>
          <inertia>
            <ixx>0.0012</ixx>
            <iyy>0.0156</iyy>
            <izz>0.0156</izz>
          </inertia>
        </inertial>
        <collision name="bar">
          <geometry>
            <box>
              <size>0.6 0.12 0.12</size>
            </box>
          </geometry>
        </collision>
        <visual name="bar">
          <geometry>
            <box>
              <size>0.6 0.12 0.12</size>
            </box>
          </geometry>
          <material>
            <diffuse>0.15 0.3 0.8 1</diffuse>
          </material>
        </visual>
      </link>
      <joint name="base_hinge" type="revolute">
        <parent>world</parent>
        <child>base</child>
        <pose relative_to="base">0 0 0 0 0 0</pose>
        <axis>
          <xyz>0 1 0</xyz>
        </axis>
      </joint>
      <joint name="tip_hinge" type="revolute">
        <parent>base</parent>
        <child>tip</child>
        <pose relative_to="tip">0 0 0 0 0 0</pose>
        <axis>
          <xyz>0 1 0</xyz>
        </axis>
      </joint>
      <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
        <topic>/m57/joint1</topic>
        <update_rate>50</update_rate>
        <joint_name>tip_hinge</joint_name>
        <joint_name>tip_hinge</joint_name>
      </plugin>
    </model>
  </world>
</sdf>
