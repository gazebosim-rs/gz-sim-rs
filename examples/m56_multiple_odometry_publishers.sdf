<sdf version="1.12">
  <world name="default">
    <gravity>0 0 0</gravity>
    <physics name="one_ms" type="ignored"><max_step_size>0.001</max_step_size></physics>
    <model name="planar">
      <pose>2 -1 3 0 0 0.6</pose>
      <link name="body">
        <inertial><mass>1</mass><inertia><ixx>1</ixx><iyy>1</iyy><izz>1</izz></inertia></inertial>
        <collision name="box"><geometry><box><size>1 1 1</size></box></geometry></collision>
        <visual name="box"><geometry><box><size>1 1 1</size></box></geometry></visual>
      </link>
      <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
        <dimensions>2</dimensions><odom_publish_frequency>50</odom_publish_frequency>
        <odom_topic>/m56/planar/odometry</odom_topic>
        <odom_covariance_topic>/m56/planar/odometry_covariance</odom_covariance_topic>
        <tf_topic>/m56/planar/transform</tf_topic>
        <odom_frame>m56/planar/odom</odom_frame><robot_base_frame>m56/planar/base</robot_base_frame>
      </plugin>
    </model>
    <model name="spatial">
      <pose>2 8 3 0.2 0.3 0.6</pose>
      <link name="body">
        <inertial><mass>1</mass><inertia><ixx>1</ixx><iyy>1</iyy><izz>1</izz></inertia></inertial>
        <collision name="box"><geometry><box><size>1 1 1</size></box></geometry></collision>
        <visual name="box"><geometry><box><size>1 1 1</size></box></geometry></visual>
      </link>
      <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
        <dimensions>3</dimensions><odom_publish_frequency>25</odom_publish_frequency>
        <xyz_offset>0.4 -0.3 0.2</xyz_offset>
        <rpy_offset>0.3 -0.4 0.5</rpy_offset>
        <xyz_global_offset>-0.7 0.5 -0.6</xyz_global_offset>
        <rpy_global_offset>-0.2 0.25 -0.35</rpy_global_offset>
        <odom_topic>/m56/spatial/odometry</odom_topic>
        <odom_covariance_topic>/m56/spatial/odometry_covariance</odom_covariance_topic>
        <tf_topic>/m56/spatial/transform</tf_topic>
        <odom_frame>m56/spatial/odom</odom_frame><robot_base_frame>m56/spatial/base</robot_base_frame>
      </plugin>
    </model>
  </world>
</sdf>
