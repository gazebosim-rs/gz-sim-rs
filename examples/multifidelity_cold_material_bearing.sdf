<?xml version="1.0"?>
<!-- A supported foot is imported after 1 physical contact tick from nominal donor 30. Both material points have matching normal speed. -->
<sdf version="1.12">
  <world name="default">
    <gravity>0 0 -9.81</gravity>
    <physics name="fixed" type="ignored"><max_step_size>0.0005</max_step_size><real_time_factor>0.01</real_time_factor></physics>
    <plugin name="gz::sim::systems::PrimaryContactRefinement" filename="gz-sim-primary-contact-refinement-system">
      <native_steps>8</native_steps><solver_iterations>4</solver_iterations>
      <pgs_iterations>1</pgs_iterations><relaxation_iterations>1</relaxation_iterations>
      <pair><foot>default::rocker::foot</foot><support>default::lift::pad</support><project_finite_point>true</project_finite_point><resolve_point_transfers>true</resolve_point_transfers><follow_sliding_skew_edge>true</follow_sliding_skew_edge><follow_skew_slip_launch>true</follow_skew_slip_launch><subdivide_point_bounds>true</subdivide_point_bounds><compact_point_tail>true</compact_point_tail><target_point_bounds>true</target_point_bounds><refine_active_point>true</refine_active_point><detect_initial_point>true</detect_initial_point></pair>
    </plugin>
    <model name="rocker">
      <pose>5.92942641387199417e-5 -1.54192237436935039e-5 3.88627300499138489e-2 -1.20014179269767250e-4 -5.20506057904701687e-6 -8.87486755194452702e-5</pose>
      <plugin name="gz::sim::systems::InitialVelocity" filename="gz-sim-initial-velocity-system">
        <linear_velocity>1.00819788220346557e-2 1.90363998970883047e-1 4.35533383955566455e-1</linear_velocity><angular_velocity>-1.27256820651172053e0 -5.91222571619718154e-2 1.77818979917639536e-1</angular_velocity>
      </plugin>
      <plugin name="gz::sim::systems::SwitchableArticulation" filename="gz-sim-switchable-articulation-system">
        <exact_revolute_locks>true</exact_revolute_locks>
      </plugin>
      <link name="foot">
        <inertial><mass>1</mass><inertia><ixx>0.0201</ixx><iyy>0.0201</iyy><izz>0.025</izz></inertia></inertial>
        <collision name="sole"><geometry><box><size>0.36 0.20 0.12</size></box></geometry><surface><friction><ode><mu>0.5</mu><mu2>0.5</mu2></ode></friction></surface></collision>
        <visual name="sole"><geometry><box><size>0.36 0.20 0.12</size></box></geometry><material><diffuse>0.92 0.46 0.12 1</diffuse></material></visual>
      </link>
      <link name="upper">
        <pose>0 0 0.14 0 0 0</pose>
        <inertial><mass>1</mass><inertia><ixx>0.0201</ixx><iyy>0.0201</iyy><izz>0.025</izz></inertia></inertial>
        <collision name="c"><geometry><box><size>0.10 0.12 0.12</size></box></geometry><surface><friction><ode><mu>0.5</mu><mu2>0.5</mu2></ode></friction></surface></collision>
        <visual name="v"><geometry><box><size>0.10 0.12 0.12</size></box></geometry><material><diffuse>0.90 0.73 0.21 1</diffuse></material></visual>
      </link>
      <joint name="hinge" type="revolute">
        <parent>foot</parent><child>upper</child>
        <axis><xyz>1 0 0</xyz><limit><lower>0</lower><upper>0</upper></limit></axis>
      </joint>
    </model>
    <model name="lift">
      <pose>1.90000000000000002e-1 0.00000000000000000e0 -8.11500000000003191e-2 0.00000000000000000e0 -0.00000000000000000e0 0.00000000000000000e0</pose>
      <plugin name="gz::sim::systems::PrescribedMotion" filename="gz-sim-prescribed-motion-system">
        <linear_velocity>0.00000000000000000e0 0.00000000000000000e0 2.99999999999999989e-1</linear_velocity><angular_velocity>0 0 0</angular_velocity>
      </plugin>
      <link name="pad">
        <collision name="platform"><geometry><box><size>0.66 0.36 0.12</size></box></geometry><surface><friction><ode><mu>0.5</mu><mu2>0.5</mu2></ode></friction></surface></collision>
        <visual name="platform"><geometry><box><size>0.66 0.36 0.12</size></box></geometry><material><diffuse>0.15 0.48 0.73 1</diffuse></material></visual>
      </link>
    </model>
  </world>
</sdf>
