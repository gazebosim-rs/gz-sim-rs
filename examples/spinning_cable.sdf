<sdf version="1.12">
  <world name="default">
    <gravity>0 0 0</gravity>
    <physics name="ten_ms" type="ignored"><max_step_size>0.01</max_step_size></physics>
    <plugin name="gz::sim::systems::Deformables" filename="gz-sim-deformables-system">
      <cable name="rotor" substeps="1" iterations="16" radius="0.025" self_contact="false" friction="0" stretch="0" bend="0" conserve_angular_momentum="true">
        <particle position="0 -0.35 0.8" velocity="0 -0 -2.1" mass="0.05"/>
        <particle position="0 0.35 0.8" velocity="0 -0 2.1" mass="0.05"/>
      </cable>
    </plugin>
  </world>
</sdf>
