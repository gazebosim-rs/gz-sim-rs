<sdf version="1.12">
  <world name="default">
    <gravity>0 0 0</gravity>
    <physics name="one_ms" type="ignored"><max_step_size>0.001</max_step_size></physics>
    <model name="rig">
      <pose>2 -1 3 0 0 0.6</pose>
      <link name="body">
        <inertial><mass>1</mass><inertia><ixx>1</ixx><iyy>1</iyy><izz>1</izz></inertia></inertial>
        <collision name="box"><geometry><box><size>1 1 1</size></box></geometry></collision>
        <visual name="box"><geometry><box><size>1 1 1</size></box></geometry></visual>
      </link>
      <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
        <dimensions>2</dimensions><odom_publish_frequency>50</odom_publish_frequency>
        <odom_topic>/m34/odometry</odom_topic>
        <odom_covariance_topic>/m34/odometry_covariance</odom_covariance_topic>
        <tf_topic>/m34/transform</tf_topic>
        <odom_frame>m34/odom</odom_frame><robot_base_frame>m34/base</robot_base_frame>
      </plugin>
    </model>
  </world>
</sdf>
