<!-- Select the multifidelity engine and run for 500 iterations. -->
<sdf version="1.12">
  <world name="default">
    <gravity>0 0 -9.81</gravity>
    <physics name="one_ms" type="ignored">
      <max_step_size>0.001</max_step_size>
    </physics>
    <model name="platform">
      <pose>0 0 0.1 0 0 0</pose>
      <link name="body">
        <collision name="deck"><geometry><box><size>2 1 0.2</size></box></geometry></collision>
        <visual name="deck_visual">
          <geometry><box><size>2 1 0.2</size></box></geometry>
          <material><diffuse>0.04 0.30 0.72 1</diffuse></material>
        </visual>
      </link>
      <plugin filename="gz-sim-prescribed-motion-system" name="gz::sim::systems::PrescribedMotion">
        <linear_velocity>1 0 0</linear_velocity>
        <angular_velocity>0 0 0</angular_velocity>
      </plugin>
    </model>
    <model name="cargo">
      <!-- The cargo falls 4 cm before making contact with the translating deck. -->
      <pose>0 0 0.34 0 0 0</pose>
      <link name="body">
        <inertial>
          <mass>1.2</mass>
          <inertia><ixx>0.02</ixx><iyy>0.02</iyy><izz>0.032</izz></inertia>
        </inertial>
        <collision name="box"><geometry><box><size>0.4 0.4 0.2</size></box></geometry></collision>
        <visual name="box_visual">
          <geometry><box><size>0.4 0.4 0.2</size></box></geometry>
          <material><diffuse>0.95 0.25 0.04 1</diffuse></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
