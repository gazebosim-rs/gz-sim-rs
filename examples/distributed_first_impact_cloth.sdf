<sdf version="1.12">
  <world name="default">
    <gravity>0 0 0</gravity>
    <physics name="ten_ms" type="ignored"><max_step_size>0.01</max_step_size></physics>
    <model name="gripper">
      <pose>-0.32 0 0.58 0 0 0</pose>
      <self_collide>false</self_collide>
      <plugin filename="gz-sim-switchable-articulation-system" name="gz::sim::systems::SwitchableArticulation"/>
      <link name="palm">
        <inertial><mass>2.4</mass><inertia><ixx>0.10</ixx><iyy>0.09</iyy><izz>0.13</izz></inertia></inertial>
        <collision name="ball"><geometry><sphere><radius>0.14</radius></sphere></geometry></collision>
        <visual name="palm_hub"><geometry><sphere><radius>0.14</radius></sphere></geometry><material><diffuse>0.15 0.28 0.53 1</diffuse></material></visual>
        <visual name="crossbar"><pose>0.02 0 0 0 0 0</pose><geometry><box><size>0.15 0.58 0.095</size></box></geometry><material><diffuse>0.2 0.36 0.58 1</diffuse></material></visual>
        <visual name="cloth_corner_0"><pose>0.38160995064 -0.502045014808 0.27567636723 0 0 0</pose><geometry><sphere><radius>0.022</radius></sphere></geometry><material><diffuse>0.98 0.59 0.12 1</diffuse></material></visual>
        <visual name="cloth_corner_1"><pose>0.88080995064 -0.502045014808 0.13007636723 0 0 0</pose><geometry><sphere><radius>0.022</radius></sphere></geometry><material><diffuse>0.98 0.59 0.12 1</diffuse></material></visual>
        <visual name="cloth_corner_2"><pose>0.38160995064 0.477954985192 0.27567636723 0 0 0</pose><geometry><sphere><radius>0.022</radius></sphere></geometry><material><diffuse>0.98 0.59 0.12 1</diffuse></material></visual>
        <visual name="cloth_corner_3"><pose>0.88080995064 0.477954985192 0.13007636723 0 0 0</pose><geometry><sphere><radius>0.022</radius></sphere></geometry><material><diffuse>0.98 0.59 0.12 1</diffuse></material></visual>
      </link>
      <link name="left_finger">
        <pose>0.64 0.29 0 0 0 0</pose>
        <inertial><pose>-0.035 0.012 0.008 0.22 -0.14 0.27</pose><mass>0.83</mass><inertia><ixx>0.026</ixx><iyy>0.031</iyy><izz>0.039</izz></inertia></inertial>
        <collision name="pad"><geometry><sphere><radius>0.10</radius></sphere></geometry></collision>
        <visual name="left_pad"><geometry><sphere><radius>0.10</radius></sphere></geometry><material><diffuse>0.08 0.73 0.65 1</diffuse></material></visual>
        <visual name="left_shank"><pose>-0.30 0 0 0 0 0</pose><geometry><box><size>0.60 0.065 0.065</size></box></geometry><material><diffuse>0.12 0.58 0.55 1</diffuse></material></visual>
      </link>
      <link name="right_finger">
        <pose>0.64 -0.29 0 0 0 0</pose>
        <inertial><pose>0.026 -0.018 0.011 -0.19 0.15 0.24</pose><mass>0.76</mass><inertia><ixx>0.023</ixx><iyy>0.033</iyy><izz>0.041</izz></inertia></inertial>
        <collision name="pad"><geometry><sphere><radius>0.10</radius></sphere></geometry></collision>
        <visual name="right_pad"><geometry><sphere><radius>0.10</radius></sphere></geometry><material><diffuse>0.23 0.61 0.90 1</diffuse></material></visual>
        <visual name="right_shank"><pose>-0.30 0 0 0 0 0</pose><geometry><box><size>0.60 0.065 0.065</size></box></geometry><material><diffuse>0.18 0.49 0.75 1</diffuse></material></visual>
      </link>
      <joint name="right_close" type="revolute">
        <parent>palm</parent><child>right_finger</child><pose relative_to="palm">0.04 -0.29 0 0 0 0</pose>
        <axis><xyz expressed_in="__model__">0 0 1</xyz><limit><lower>-0.42</lower><upper>0.42</upper></limit></axis>
      </joint>
      <joint name="left_close" type="revolute">
        <parent>palm</parent><child>left_finger</child><pose relative_to="palm">0.04 0.29 0 0 0 0</pose>
        <axis><xyz expressed_in="__model__">0 0 1</xyz><limit><lower>-0.42</lower><upper>0.42</upper></limit></axis>
      </joint>
    </model>
    <plugin filename="gz-sim-deformables-system" name="gz::sim::systems::Deformables">
      <cloth name="material" columns="2" shear="0.003" substeps="2" iterations="6" radius="0.012" self_contact="false" friction="0" stretch="0.002" bend="0.005" conserve_angular_momentum="true">
        <particle position="0.06160995064 -0.502045014808 0.85567636723" velocity="0.4 0.12 -0.95" mass="0.085"/>
        <particle position="0.56080995064 -0.502045014808 0.71007636723" velocity="0.4 0.12 -0.95" mass="0.11"/>
        <particle position="0.06160995064 0.477954985192 0.85567636723" velocity="0.4 0.12 -0.95" mass="0.14"/>
        <particle position="0.56080995064 0.477954985192 0.71007636723" velocity="0.4 0.12 -0.95" mass="0.095"/>
      </cloth>
      <particle_visual material="material" particle="0" visual="default::gripper::palm::cloth_corner_0"/>
      <particle_visual material="material" particle="1" visual="default::gripper::palm::cloth_corner_1"/>
      <particle_visual material="material" particle="2" visual="default::gripper::palm::cloth_corner_2"/>
      <particle_visual material="material" particle="3" visual="default::gripper::palm::cloth_corner_3"/>
      <articulated_impact material="material" detection="first_impact" restitution="0.55">
        <sphere link="default::gripper::left_finger"/>
        <sphere link="default::gripper::right_finger"/>
      </articulated_impact>
    </plugin>
  </world>
</sdf>
