<sdf version='1.12'><world name='default'>
  <gravity>0 0 0</gravity>
  <magnetic_field>0.00002 -0.00003 0.00004</magnetic_field>
  <physics name='step' type='ode'><max_step_size>0.001</max_step_size></physics>
  <plugin filename='gz-sim-magnetometer-system' name='gz::sim::systems::Magnetometer'/>
  <model name='rig'><pose>0 0 3 0.2 -0.3 0.4</pose><link name='body'>
    <inertial><mass>2</mass><inertia><ixx>1</ixx><iyy>1</iyy><izz>1</izz></inertia></inertial>
    <collision name='box'><geometry><box><size>1 1 1</size></box></geometry></collision>
    <sensor name='front_magnetometer' type='magnetometer'>
      <pose>1 0.5 0.5 0.3 0.4 -0.2</pose>
      <always_on>true</always_on><update_rate>100</update_rate>
      <topic>/m52/front_magnetometer</topic><frame_id>rig/body/front_magnetometer</frame_id>
      <magnetometer/>
    </sensor>
    <sensor name='rear_magnetometer' type='magnetometer'>
      <pose>-1 -0.5 -0.5 -0.2 0.1 0.6</pose>
      <always_on>true</always_on><update_rate>50</update_rate>
      <topic>/m52/rear_magnetometer</topic><frame_id>rig/body/rear_magnetometer</frame_id>
      <magnetometer><x><noise type='gaussian'><mean>0.000001</mean><stddev>0</stddev></noise></x></magnetometer>
    </sensor>
  </link></model>
</world></sdf>
