<sdf version="1.12">
  <world name="default">
    <gravity>0 0 0</gravity>
    <physics name="clock" type="ignored">
      <max_step_size>0.0005</max_step_size>
    </physics>
    <model name="ball">
      <pose>0 0 0.23 0 0 0</pose>
      <plugin name="gz::sim::systems::InitialVelocity" filename="gz-sim-initial-velocity-system">
        <linear_velocity>0 0 -2</linear_velocity>
        <angular_velocity>0 0 0</angular_velocity>
      </plugin>
      <plugin name="gz::sim::systems::ContactMaterial" filename="gz-sim-contact-material-system">
        <restitution link="body">0.65</restitution>
      </plugin>
      <link name="body">
        <inertial>
          <mass>1</mass>
          <inertia>
            <ixx>0.00256</ixx>
            <iyy>0.00256</iyy>
            <izz>0.00256</izz>
          </inertia>
        </inertial>
        <collision name="shape">
          <geometry>
            <sphere>
              <radius>0.08</radius>
            </sphere>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>0</mu>
                <mu2>0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="shape">
          <geometry>
            <sphere>
              <radius>0.08</radius>
            </sphere>
          </geometry>
          <material>
            <ambient>0.24 0.58 0.91 1</ambient>
            <diffuse>0.24 0.58 0.91 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="floor">
      <pose>0 0 -0.025 0 0 0</pose>
      <static>true</static>
      <plugin name="gz::sim::systems::ContactMaterial" filename="gz-sim-contact-material-system">
        <restitution link="body">0.2</restitution>
      </plugin>
      <link name="body">
        <collision name="shape">
          <geometry>
            <box>
              <size>2 2 0.05</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>0</mu>
                <mu2>0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="shape">
          <geometry>
            <box>
              <size>2 2 0.05</size>
            </box>
          </geometry>
          <material>
            <ambient>0.6 0.67 0.77 1</ambient>
            <diffuse>0.6 0.67 0.77 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
