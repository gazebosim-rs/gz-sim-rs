<?xml version="1.0"?>
<!-- The 25 us solver step resolves the initial sliding transient prior to demotion.
     The two kilogram-scale links have a locked joint and prescribed mass tensors.
     The two toe corners start 50 micrometers inside the x=0 lip of a finite box. -->
<sdf version="1.12">
  <world name="default">
    <gravity>0 0 -9.81</gravity>
    <physics name="fixed" type="ignored"><max_step_size>0.000025</max_step_size></physics>
    <model name="rocker">
      <pose>-0.08005 0 0.05999 0 0 0</pose>
      <plugin name="gz::sim::systems::SwitchableArticulation" filename="gz-sim-switchable-articulation-system">
        <exact_revolute_locks>true</exact_revolute_locks>
      </plugin>
      <plugin name="gz::sim::systems::InitialVelocity" filename="gz-sim-initial-velocity-system">
        <linear_velocity>0.002 0 0</linear_velocity>
        <angular_velocity>0 -0.012 0</angular_velocity>
      </plugin>
      <link name="foot">
        <inertial><mass>1</mass><inertia><ixx>0.0201</ixx><iyy>0.0201</iyy><izz>0.025</izz></inertia></inertial>
        <collision name="c"><geometry><box><size>0.16 0.20 0.12</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.16 0.20 0.12</size></box></geometry></visual>
      </link>
      <link name="upper">
        <pose>0 0 0.14 0 0 0</pose>
        <inertial><mass>1</mass><inertia><ixx>0.0201</ixx><iyy>0.0201</iyy><izz>0.025</izz></inertia></inertial>
        <collision name="c"><geometry><box><size>0.10 0.12 0.12</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.10 0.12 0.12</size></box></geometry></visual>
      </link>
      <joint name="hinge" type="revolute">
        <parent>foot</parent><child>upper</child>
        <axis><xyz>1 0 0</xyz><limit><lower>0</lower><upper>0</upper></limit></axis>
      </joint>
    </model>
    <model name="ledge">
      <static>true</static><pose>-0.20 0 -0.08 0 0 0</pose>
      <link name="ground">
        <collision name="c"><geometry><box><size>0.4 0.5 0.16</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.4 0.5 0.16</size></box></geometry></visual>
      </link>
    </model>
  </world>
</sdf>
