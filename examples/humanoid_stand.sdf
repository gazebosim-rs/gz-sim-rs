    <plugin filename="gz-sim-joint-posture-system" name="gz::sim::systems::JointPosture">
      <model>default::humanoid</model>
      <balance position_gain="2.8" velocity_gain="0.58" max_x="0.24" max_y="0.20"/>
      <actuator joint="spine_yaw" reference="0" stiffness="700" damping="22" max_effort="105"/>
      <actuator joint="spine_roll" reference="0" stiffness="700" damping="22" max_effort="105"/>
      <actuator joint="spine_pitch" reference="0" stiffness="700" damping="22" max_effort="105"/>
