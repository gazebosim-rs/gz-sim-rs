<sdf version="1.12"><world name="default">
  <gravity>0 0 0</gravity>
  <physics name="step" type="ignored"><max_step_size>0.001</max_step_size></physics>
  <plugin name="gz::sim::systems::ApplyLinkWrench" filename="gz-sim-apply-link-wrench-system"/>
  <model name="rig"><link name="body">
    <inertial><mass>2</mass><inertia><ixx>1</ixx><iyy>1</iyy><izz>1</izz></inertia></inertial>
    <collision name="box"><geometry><box><size>0.2 0.2 0.2</size></box></geometry></collision>
    <visual name="box"><geometry><box><size>0.2 0.2 0.2</size></box></geometry></visual>
  </link></model>
  <model name="other"><pose>0 3 0 0 0 0</pose><link name="body">
    <inertial><mass>2</mass><inertia><ixx>1</ixx><iyy>1</iyy><izz>1</izz></inertia></inertial>
    <collision name="box"><geometry><box><size>0.2 0.2 0.2</size></box></geometry></collision>
    <visual name="box"><geometry><box><size>0.2 0.2 0.2</size></box></geometry></visual>
  </link></model>
</world></sdf>
