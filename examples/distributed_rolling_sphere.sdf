<sdf version="1.12">
  <world name="default">
    <gravity>2.1 0 -9.81</gravity>
    <physics name="local_workers" type="ignored"><max_step_size>0.005</max_step_size><real_time_factor>0.2</real_time_factor></physics>
    <model name="ground">
      <static>true</static>
      <pose>0 0 0.25 0 0 0</pose>
      <link name="floor">
        <collision name="terrain">
          <geometry><plane><normal>0 0 1</normal><size>18 6</size></plane></geometry>
          <surface><friction><ode><mu>0.25</mu><mu2>0.25</mu2></ode></friction></surface>
        </collision>
        <visual name="surface">
          <pose>0 0 -0.025 0 0 0</pose>
          <geometry><box><size>18 6 0.05</size></box></geometry>
          <material><diffuse>0.34 0.40 0.47 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="roller">
      <pose>-3 0 0.65 0 0 0</pose>
      <link name="body">
        <inertial><mass>1</mass><inertia><ixx>0.036</ixx><iyy>0.036</iyy><izz>0.036</izz></inertia></inertial>
        <collision name="shell"><geometry><sphere><radius>0.3</radius></sphere></geometry><surface><friction><ode><mu>0.72</mu><mu2>0.72</mu2></ode></friction></surface></collision>
        <visual name="paint"><geometry><sphere><radius>0.3</radius></sphere></geometry><material><diffuse>0.94 0.22 0.08 1</diffuse></material></visual>
        <visual name="spin_marker"><pose>0.18 -0.18 0.13 0 0 0</pose><geometry><sphere><radius>0.070</radius></sphere></geometry><material><diffuse>1 0.95 0.77 1</diffuse></material></visual>
      </link>
    </model>
    <model name="block">
      <pose>3 0 0.50 0 0 0</pose>
      <link name="body">
        <inertial><mass>2</mass><inertia><ixx>0.053333333333333344</ixx><iyy>0.053333333333333344</iyy><izz>0.053333333333333344</izz></inertia></inertial>
        <collision name="box"><geometry><box><size>0.4 0.4 0.4</size></box></geometry><surface><friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction></surface></collision>
        <visual name="paint"><geometry><box><size>0.4 0.4 0.4</size></box></geometry><material><diffuse>0.08 0.42 0.90 1</diffuse></material></visual>
      </link>
    </model>
  </world>
</sdf>
