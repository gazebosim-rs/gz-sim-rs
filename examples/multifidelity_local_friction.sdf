<?xml version="1.0"?>
<sdf version="1.12">
  <world name="default">
    <gravity>0 0 -9.81</gravity>
    <physics name="fixed" type="ignored"><max_step_size>0.0005</max_step_size><real_time_factor>0.15</real_time_factor></physics>
    <model name="runway">
      <static>true</static><pose>0 0 -0.05 0 0 0</pose>
      <link name="deck">
        <collision name="surface">
          <geometry><box><size>3.5 1.7 0.1</size></box></geometry>
          <surface><friction><ode><mu>1</mu><mu2>1</mu2></ode></friction></surface>
        </collision>
        <visual name="deck"><geometry><box><size>3.5 1.7 0.1</size></box></geometry>
          <material><diffuse>0.32 0.37 0.40 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="ice">
      <pose>-0.8 -0.53 0.1 0 0 0</pose>
      <plugin name="gz::sim::systems::InitialVelocity" filename="gz-sim-initial-velocity-system">
        <linear_velocity>2.1 0 0</linear_velocity><angular_velocity>0 0 0</angular_velocity>
      </plugin>
      <link name="ball">
        <inertial><mass>1</mass><inertia><ixx>0.004</ixx><iyy>0.004</iyy><izz>0.004</izz></inertia></inertial>
        <collision name="skin"><geometry><sphere><radius>0.1</radius></sphere></geometry>
          <surface><friction><ode><mu>0</mu><mu2>0</mu2></ode></friction></surface>
        </collision>
        <visual name="shell"><geometry><sphere><radius>0.1</radius></sphere></geometry>
          <material><diffuse>0.15 0.64 0.94 1</diffuse></material>
        </visual>
        <visual name="rotation_mark"><pose>0 0 0.092 0 0 0</pose><geometry><sphere><radius>0.018</radius></sphere></geometry>
          <material><diffuse>1 1 1 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="medium">
      <pose>-0.8 0 0.1 0 0 0</pose>
      <plugin name="gz::sim::systems::InitialVelocity" filename="gz-sim-initial-velocity-system">
        <linear_velocity>2.1 0 0</linear_velocity><angular_velocity>0 0 0</angular_velocity>
      </plugin>
      <link name="ball">
        <inertial><mass>1</mass><inertia><ixx>0.004</ixx><iyy>0.004</iyy><izz>0.004</izz></inertia></inertial>
        <collision name="skin"><geometry><sphere><radius>0.1</radius></sphere></geometry>
          <surface><friction><ode><mu>0.2</mu><mu2>0.2</mu2></ode></friction></surface>
        </collision>
        <visual name="shell"><geometry><sphere><radius>0.1</radius></sphere></geometry>
          <material><diffuse>0.97 0.59 0.12 1</diffuse></material>
        </visual>
        <visual name="rotation_mark"><pose>0 0 0.092 0 0 0</pose><geometry><sphere><radius>0.018</radius></sphere></geometry>
          <material><diffuse>1 1 1 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="grip">
      <pose>-0.8 0.53 0.1 0 0 0</pose>
      <plugin name="gz::sim::systems::InitialVelocity" filename="gz-sim-initial-velocity-system">
        <linear_velocity>2.1 0 0</linear_velocity><angular_velocity>0 0 0</angular_velocity>
      </plugin>
      <link name="ball">
        <inertial><mass>1</mass><inertia><ixx>0.004</ixx><iyy>0.004</iyy><izz>0.004</izz></inertia></inertial>
        <collision name="skin"><geometry><sphere><radius>0.1</radius></sphere></geometry>
          <surface><friction><ode><mu>0.6</mu><mu2>0.6</mu2></ode></friction></surface>
