<?xml version="1.0"?>
<!-- A locked foot slides over two finite translating supports with equal kinetic traction. -->
<sdf version="1.12">
  <world name="default">
    <gravity>1.61319528014284530 2.14131955344870883 -9.43790504074623016</gravity>
    <physics name="fixed" type="ignored"><max_step_size>0.0005</max_step_size><real_time_factor>1</real_time_factor></physics>

    <plugin name="gz::sim::systems::PrimaryContactRefinement" filename="gz-sim-primary-contact-refinement-system"><native_steps>8</native_steps><solver_iterations>4</solver_iterations><pair><foot>default::rocker::foot</foot><support>default::lift::pad</support><follow_frictionless_face>true</follow_frictionless_face><share_coplanar_face>true</share_coplanar_face><share_uniform_sliding>true</share_uniform_sliding></pair><pair><foot>default::rocker::foot</foot><support>default::toe::pad</support><follow_frictionless_face>true</follow_frictionless_face><share_coplanar_face>true</share_coplanar_face><share_uniform_sliding>true</share_uniform_sliding></pair></plugin>
    <model name="rocker">
      <pose>1.38925822559445056 -1.90177365817758837 0.63021186277876939 0.17423160799951687 -0.23436669157345891 0.24859036231090681</pose>
      <plugin name="gz::sim::systems::InitialVelocity" filename="gz-sim-initial-velocity-system">
        <linear_velocity>-0.43552961683987979 -0.37625337569373590 0.06016673125148148</linear_velocity><angular_velocity>0.00000000000000000 0.00000000000000000 0.00000000000000000</angular_velocity>
      </plugin>
      <plugin name="gz::sim::systems::SwitchableArticulation" filename="gz-sim-switchable-articulation-system">
        <exact_revolute_locks>true</exact_revolute_locks>
      </plugin>
      <link name="foot">
        <inertial><mass>1.00000000000000000</mass><inertia><ixx>0.01610000000000000</ixx><iyy>0.02160000000000000</iyy><izz>0.02950000000000000</izz><ixy>0.00100000000000000</ixy><ixz>-0.00400000000000000</ixz><iyz>0.00300000000000000</iyz></inertia></inertial>
        <collision name="sole"><geometry><box><size>0.36 0.20 0.12</size></box></geometry><surface><friction><ode><mu>0.46</mu><mu2>0.46</mu2></ode></friction></surface></collision>
        <visual name="sole"><geometry><box><size>0.36 0.20 0.12</size></box></geometry><material><diffuse>0.92 0.46 0.12 1</diffuse></material></visual>
      </link>
      <link name="upper">
        <pose>0 0 0.14 0 0 0</pose>
        <inertial><mass>1.00000000000000000</mass><inertia><ixx>0.01610000000000000</ixx><iyy>0.02160000000000000</iyy><izz>0.02950000000000000</izz><ixy>0.00100000000000000</ixy><ixz>-0.00400000000000000</ixz><iyz>0.00300000000000000</iyz></inertia></inertial>
        <collision name="c"><geometry><box><size>0.10 0.12 0.12</size></box></geometry><surface><friction><ode><mu>0.46</mu><mu2>0.46</mu2></ode></friction></surface></collision>
        <visual name="v"><geometry><box><size>0.10 0.12 0.12</size></box></geometry><material><diffuse>0.90 0.73 0.21 1</diffuse></material></visual>
      </link>
      <joint name="hinge" type="revolute">
        <parent>foot</parent><child>upper</child>
        <axis><xyz>1 0 0</xyz><limit><lower>0</lower><upper>0</upper></limit></axis>
      </joint>
    </model>
    <model name="lift"><pose>1.27300365741521238 -1.88082828445186157 0.48811975639369065 0.21129145339086211 -0.20171842618213642 0.07769036470377531</pose>
      <plugin name="gz::sim::systems::PrescribedMotion" filename="gz-sim-prescribed-motion-system"><linear_velocity>0.23518054799366678 -0.09965794325203314 0.25027943872087760</linear_velocity><angular_velocity>0 0 0</angular_velocity></plugin>
      <link name="pad"><collision name="platform"><geometry><box><size>0.22800000000000001 0.32000000000000001 0.12</size></box></geometry><surface><friction><ode><mu>0.46</mu><mu2>0.46</mu2></ode></friction></surface></collision><visual name="platform"><geometry><box><size>0.22800000000000001 0.32000000000000001 0.12</size></box></geometry><material><diffuse>0.28 0.57 0.30 1</diffuse></material></visual></link></model>
    <model name="toe"><pose>1.54847989139588638 -1.87473041060273538 0.54103157403724833 0.26065338748619654 -0.13105893828693091 -0.21804935280617813</pose>
      <plugin name="gz::sim::systems::PrescribedMotion" filename="gz-sim-prescribed-motion-system"><linear_velocity>-0.11358873771977748 -0.24348756812171862 0.15142083083679159</linear_velocity><angular_velocity>0 0 0</angular_velocity></plugin>
      <link name="pad"><collision name="platform"><geometry><box><size>0.23599999999999999 0.29999999999999999 0.12</size></box></geometry><surface><friction><ode><mu>0.46</mu><mu2>0.46</mu2></ode></friction></surface></collision><visual name="platform"><geometry><box><size>0.23599999999999999 0.29999999999999999 0.12</size></box></geometry><material><diffuse>0.15 0.40 0.75 1</diffuse></material></visual></link></model>
  </world>
</sdf>
