<?xml version="1.0"?>
<sdf version="1.12">
  <world name="default">
    <gravity>0 0 -1.2</gravity>
    <physics name="gpu" type="ignored"><max_step_size>0.001</max_step_size><real_time_factor>0.08</real_time_factor><real_time_update_rate>80</real_time_update_rate></physics>
    <plugin name="gz::sim::systems::GpuBatch" filename="gz-sim-gpu-batch-system">
      <observe every="10"/>
      <environment id="80" profile="supported-pair" friction="0.35" restitution="0.50">
