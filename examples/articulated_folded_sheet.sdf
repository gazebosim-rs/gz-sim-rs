<sdf version="1.12">
  <world name="default">
    <gravity>0 0 -9.81</gravity>
    <physics name="native" type="ignored"><max_step_size>0.001</max_step_size></physics>
    <model name="rotor">
      <link name="pad">
        <pose>0 0 0.64 0 0 0</pose>
        <inertial><mass>0.75</mass><inertia><ixx>0.022</ixx><iyy>0.022</iyy><izz>0.022</izz></inertia></inertial>
        <collision name="sphere"><geometry><sphere><radius>0.12</radius></sphere></geometry></collision>
        <visual name="sphere"><geometry><sphere><radius>0.12</radius></sphere></geometry><material><diffuse>0.12 0.46 0.74 1</diffuse></material></visual>
      </link>
      <joint name="pivot" type="revolute">
        <parent>world</parent><child>pad</child><pose relative_to="pad">0 0 0 0 0 0</pose>
        <axis><xyz expressed_in="__model__">0 0 1</xyz><limit><lower>-2</lower><upper>2</upper></limit></axis>
      </joint>
    </model>
    <plugin filename="gz-sim-deformables-system" name="gz::sim::systems::Deformables">
      <cloth name="material" columns="2" shear="0.001" substeps="2" iterations="6" radius="0.006" self_contact="false" friction="0" stretch="0.001" bend="0.0008" conserve_angular_momentum="true">
        <particle position="-0.31 0 0.78087228258248675" mass="0.1" velocity="0 0 0"/>
        <particle position="0 -0.23999999999999999 0.66087228258248676" mass="0.1" velocity="0 0 0"/>
        <particle position="0 0.23999999999999999 0.66087228258248676" mass="0.1" velocity="0 0 0"/>
        <particle position="0.31 0 0.78087228258248675" mass="0.1" velocity="0 0 0"/>
      </cloth>
      <articulated_impact material="material" detection="persistent_contact" restitution="0" max_contact_step_ns="250000">
        <sphere link="default::rotor::pad"/>
      </articulated_impact>
    </plugin>
  </world>
</sdf>
