<sdf version="1.12"><world name="default">
  <gravity>0 0 0</gravity>
  <physics name="four_ms" type="ignored"><max_step_size>0.004</max_step_size></physics>
  <model name="platen"><pose>0 0 0.40 0 0 0</pose><link name="piston">
    <inertial><mass>0.4</mass><inertia><ixx>0.008</ixx><iyy>0.008</iyy><izz>0.0035</izz></inertia></inertial>
    <collision name="surface"><geometry><capsule><radius>0.08</radius><length>0.24</length></capsule></geometry></collision>
    <visual name="ram"><geometry><capsule><radius>0.08</radius><length>0.24</length></capsule></geometry></visual>
  </link></model>
  <plugin name="gz::sim::systems::Deformables" filename="gz-sim-deformables-system">
    <capsule link="default::platen::piston" coupling="two_way" linear_trajectory="force_aware"/>
    <cloth name="fixed_membrane" columns="2" substeps="4" iterations="6" radius="0.015" friction="0.65" stretch="0" shear="0" bend="0.0001"
           self_contact="false" capsule_contact="material" capsule_contact_history="true">
      <particle position="-0.45 -0.25 0.615" pinned="true" mass="1"/>
      <particle position="0.35 -0.25 0.615" pinned="true" mass="1"/>
      <particle position="-0.45 0.40 0.615" pinned="true" mass="1"/>
      <particle position="0.35 0.40 0.615" pinned="true" mass="1"/>
    </cloth>
  </plugin>
</world></sdf>
