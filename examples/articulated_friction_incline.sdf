<sdf version="1.12">
  <world name="default">
    <gravity>0 0 -9.81</gravity>
    <physics name="one_ms" type="ignored"><max_step_size>0.001</max_step_size></physics>
    <model name="gripper">
      <self_collide>false</self_collide>
      <link name="palm">
        <pose>-0.28389971093954924 -0.20999999999999999 0.71329521600345192 0 0 0</pose>
        <inertial><mass>0.75</mass><inertia><ixx>0.025</ixx><iyy>0.025</iyy><izz>0.025</izz></inertia></inertial>
        <collision name="pad"><geometry><sphere><radius>0.085</radius></sphere></geometry></collision>
        <visual name="pad"><geometry><sphere><radius>0.085</radius></sphere></geometry><material><diffuse>0.12 0.41 0.77 1</diffuse></material></visual>
      </link>
      <joint name="mount_palm" type="revolute">
        <parent>world</parent><child>palm</child><pose relative_to="palm">0.28389971093954924 0.20999999999999999 0 0 0 0</pose>
        <axis><xyz expressed_in="__model__">0 0 1</xyz><limit><lower>-1.2</lower><upper>1.2</upper></limit></axis>
      </joint>
      <link name="left_finger">
        <pose>0.23332648307987247 -0.20999999999999999 0.55812735779762546 0 0 0</pose>
        <inertial><mass>0.75</mass><inertia><ixx>0.025</ixx><iyy>0.025</iyy><izz>0.025</izz></inertia></inertial>
        <collision name="pad"><geometry><sphere><radius>0.085</radius></sphere></geometry></collision>
        <visual name="pad"><geometry><sphere><radius>0.085</radius></sphere></geometry><material><diffuse>0.12 0.49 0.77 1</diffuse></material></visual>
      </link>
      <joint name="mount_left_finger" type="revolute">
        <parent>palm</parent><child>left_finger</child><pose relative_to="left_finger">0 0 0 0 0 0</pose>
        <axis><xyz expressed_in="__model__">0 0 1</xyz><limit><lower>-1.2</lower><upper>1.2</upper></limit></axis>
      </joint>
      <link name="right_finger">
        <pose>0.23332648307987247 0.20999999999999999 0.55812735779762546 0 0 0</pose>
        <inertial><mass>0.75</mass><inertia><ixx>0.025</ixx><iyy>0.025</iyy><izz>0.025</izz></inertia></inertial>
        <collision name="pad"><geometry><sphere><radius>0.085</radius></sphere></geometry></collision>
        <visual name="pad"><geometry><sphere><radius>0.085</radius></sphere></geometry><material><diffuse>0.12 0.57 0.77 1</diffuse></material></visual>
      </link>
      <joint name="mount_right_finger" type="revolute">
        <parent>palm</parent><child>right_finger</child><pose relative_to="right_finger">0 0 0 0 0 0</pose>
        <axis><xyz expressed_in="__model__">0 0 1</xyz><limit><lower>-1.2</lower><upper>1.2</upper></limit></axis>
      </joint>
      <link name="rear_pad">
        <pose>-0.28389971093954924 0.20999999999999999 0.71329521600345192 0 0 0</pose>
        <inertial><mass>0.75</mass><inertia><ixx>0.025</ixx><iyy>0.025</iyy><izz>0.025</izz></inertia></inertial>
        <collision name="pad"><geometry><sphere><radius>0.085</radius></sphere></geometry></collision>
        <visual name="pad"><geometry><sphere><radius>0.085</radius></sphere></geometry><material><diffuse>0.12 0.6499999999999999 0.77 1</diffuse></material></visual>
      </link>
      <joint name="mount_rear_pad" type="revolute">
        <parent>palm</parent><child>rear_pad</child><pose relative_to="rear_pad">0 0 0 0 0 0</pose>
        <axis><xyz expressed_in="__model__">0 0 1</xyz><limit><lower>-1.2</lower><upper>1.2</upper></limit></axis>
      </joint>
    </model>
    <plugin filename="gz-sim-deformables-system" name="gz::sim::systems::Deformables">
      <cloth name="material" columns="2" shear="0.00005" substeps="2" iterations="6" radius="0.003" self_contact="false" friction="0.45" stretch="0.00005" bend="0.00005" conserve_angular_momentum="true">
        <particle position="-0.38313051408846055 -0.37 0.83493915422653808" velocity="0 0 0" mass="0.13250000000000001"/>
        <particle position="0.38313051408846055 -0.37 0.60506084577346186" velocity="0 0 0" mass="0.067500000000000004"/>
        <particle position="-0.38313051408846055 0.37 0.83493915422653808" velocity="0 0 0" mass="0.067500000000000004"/>
        <particle position="0.38313051408846055 0.37 0.60506084577346186" velocity="0 0 0" mass="0.13250000000000001"/>
      </cloth>
      <articulated_impact material="material" detection="persistent_contact" restitution="0" max_contact_step_ns="250000">
        <sphere link="default::gripper::palm"/>
        <sphere link="default::gripper::left_finger"/>
        <sphere link="default::gripper::right_finger"/>
        <sphere link="default::gripper::rear_pad"/>
      </articulated_impact>
    </plugin>
  </world>
</sdf>
