<?xml version="1.0"?>
<!-- The released foot rolls onto a rising finite support. The public actuator step remains 500 microseconds. -->
<sdf version="1.12">
  <world name="default">
    <gravity>0 0 -9.81</gravity>
    <physics name="fixed" type="ignored"><max_step_size>0.0005</max_step_size><real_time_factor>0.01</real_time_factor></physics>
    <plugin name="gz::sim::systems::PrimaryContactRefinement" filename="gz-sim-primary-contact-refinement-system">
      <native_steps>8</native_steps><solver_iterations>8</solver_iterations>
      <pair><foot>default::rocker::foot</foot><support>default::lift::pad</support></pair>
    </plugin>
    <model name="rocker">
      <pose>0 0 0.20 0 0.06 0</pose>
      <plugin name="gz::sim::systems::SwitchableArticulation" filename="gz-sim-switchable-articulation-system">
        <exact_revolute_locks>true</exact_revolute_locks>
      </plugin>
      <link name="foot">
        <inertial><mass>1</mass><inertia><ixx>0.0201</ixx><iyy>0.0201</iyy><izz>0.025</izz></inertia></inertial>
        <collision name="sole"><geometry><box><size>0.36 0.20 0.12</size></box></geometry></collision>
        <visual name="sole"><geometry><box><size>0.36 0.20 0.12</size></box></geometry><material><diffuse>0.92 0.46 0.12 1</diffuse></material></visual>
      </link>
      <link name="upper">
        <pose>0 0 0.14 0 0 0</pose>
        <inertial><mass>1</mass><inertia><ixx>0.0201</ixx><iyy>0.0201</iyy><izz>0.025</izz></inertia></inertial>
        <collision name="c"><geometry><box><size>0.10 0.12 0.12</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.10 0.12 0.12</size></box></geometry><material><diffuse>0.90 0.73 0.21 1</diffuse></material></visual>
      </link>
      <joint name="hinge" type="revolute">
        <parent>foot</parent><child>upper</child>
        <axis><xyz>1 0 0</xyz><limit><lower>0</lower><upper>0</upper></limit></axis>
      </joint>
    </model>
    <model name="lift">
      <pose>0.18 0 -0.06 0 0 0</pose>
      <plugin name="gz::sim::systems::PrescribedMotion" filename="gz-sim-prescribed-motion-system">
        <linear_velocity>0 0 0.08</linear_velocity><angular_velocity>0 0 0</angular_velocity>
      </plugin>
      <link name="pad">
        <collision name="platform"><geometry><box><size>0.66 0.36 0.12</size></box></geometry></collision>
        <visual name="platform"><geometry><box><size>0.66 0.36 0.12</size></box></geometry><material><diffuse>0.15 0.48 0.73 1</diffuse></material></visual>
      </link>
    </model>
  </world>
</sdf>
