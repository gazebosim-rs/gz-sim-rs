<sdf version="1.12">
  <world name="default">
    <gravity>0 0 0</gravity>
    <physics name="ten_ms" type="ignored"><max_step_size>0.01</max_step_size><real_time_factor>0.2</real_time_factor></physics>
    <!-- Moving sensor mount, central contact target and two curved moving targets on four workers. -->
    <model name="scanner">
      <pose>-1.8 0 0.45 0 0 0</pose>
      <link name="body">
        <inertial><mass>1</mass><inertia>
          <ixx>0.03416666666666667</ixx><iyy>0.05083333333333333</iyy><izz>0.04333333333333333</izz>
        </inertia></inertial>
        <collision name="box">
          <geometry><box><size>0.6 0.4 0.5</size></box></geometry>
          <surface><friction><ode><mu>0</mu><mu2>0</mu2></ode></friction></surface>
        </collision>
        <visual name="paint">
          <geometry><box><size>0.6 0.4 0.5</size></box></geometry>
          <material><diffuse>0.05 0.35 0.88 1</diffuse></material>
        </visual>
        <sensor name="laser" type="lidar">
          <pose>0.02 0 0.02 0 0 0</pose>
          <update_rate>100</update_rate><topic>/scan</topic><frame_id>laser</frame_id>
          <lidar><scan><horizontal><samples>31</samples><resolution>1</resolution>
            <min_angle>-0.75</min_angle><max_angle>0.75</max_angle>
          </horizontal></scan><range><min>0.05</min><max>6</max><resolution>0.001</resolution></range></lidar>
        </sensor>
      </link>
      <plugin filename="gz-sim-prescribed-motion-system" name="gz::sim::systems::PrescribedMotion">
        <linear_velocity>1.5 0 0</linear_velocity><angular_velocity>0 0 0</angular_velocity>
      </plugin>
    </model>
    <model name="target">
      <pose>0.3 0 0.45 0 0 0.36</pose>
      <link name="body">
        <inertial><mass>1</mass><inertia><ixx>0.08833333333333333</ixx><iyy>0.05083333333333333</iyy><izz>0.0975</izz></inertia></inertial>
        <collision name="box">
          <geometry><box><size>0.6 0.9 0.5</size></box></geometry>
          <surface><friction><ode><mu>0</mu><mu2>0</mu2></ode></friction></surface>
        </collision>
        <visual name="paint">
          <geometry><box><size>0.6 0.9 0.5</size></box></geometry>
          <material><diffuse>0.94 0.26 0.04 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="cylinder">
      <pose>2.10 -1.35 0.52 0 0.65 0.18</pose>
      <link name="body">
        <inertial><mass>1</mass><inertia><ixx>0.09000000000000001</ixx><iyy>0.09000000000000001</iyy><izz>0.045</izz></inertia></inertial>
        <collision name="shell"><geometry><cylinder><radius>0.3</radius><length>0.9</length></cylinder></geometry>
          <surface><friction><ode><mu>0</mu><mu2>0</mu2></ode></friction></surface>
        </collision>
        <visual name="paint"><geometry><cylinder><radius>0.3</radius><length>0.9</length></cylinder></geometry>
          <material><diffuse>0.86 0.68 0.09 1</diffuse></material>
        </visual>
      </link>
      <plugin filename="gz-sim-prescribed-motion-system" name="gz::sim::systems::PrescribedMotion">
        <linear_velocity>0.08 0.16 0</linear_velocity><angular_velocity>0.13 0.25 0.21</angular_velocity>
      </plugin>
    </model>
    <model name="capsule">
      <pose>2.60 1.45 0.52 0.5 0.9 -0.21</pose>
      <link name="body">
        <inertial><mass>1</mass><inertia><ixx>0.16684615384615384</ixx><iyy>0.16684615384615384</iyy><izz>0.042230769230769225</izz></inertia></inertial>
        <collision name="shell"><geometry><capsule><radius>0.3</radius><length>0.9</length></capsule></geometry>
          <surface><friction><ode><mu>0</mu><mu2>0</mu2></ode></friction></surface>
        </collision>
        <visual name="paint"><geometry><mesh><uri>assets/multifidelity/roller-capsule.glb</uri></mesh></geometry>
        </visual>
      </link>
      <plugin filename="gz-sim-prescribed-motion-system" name="gz::sim::systems::PrescribedMotion">
        <linear_velocity>-0.11 -0.06 0</linear_velocity><angular_velocity>-0.11 0.22 -0.13</angular_velocity>
      </plugin>
    </model>
  </world>
</sdf>
