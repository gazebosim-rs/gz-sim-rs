<sdf version="1.12">
  <world name="default">
    <gravity>0 0 0</gravity>
    <physics name="step" type="ode"><max_step_size>0.001</max_step_size></physics>
    <model name="left_scanner">
      <static>true</static><pose>0 2 0 0 0 0</pose>
      <link name="body">
        <collision name="body"><geometry><box><size>0.4 0.4 0.4</size></box></geometry></collision>
        <visual name="body"><geometry><box><size>0.4 0.4 0.4</size></box></geometry></visual>
        <sensor name="laser" type="lidar">
          <update_rate>100</update_rate><topic>/m54/left/scan</topic><frame_id>left_scanner/body/laser</frame_id>
          <lidar><scan><horizontal><samples>3</samples><resolution>1</resolution><min_angle>-0.5</min_angle><max_angle>0.5</max_angle></horizontal></scan><range><min>0.1</min><max>10</max><resolution>0.01</resolution></range></lidar>
        </sensor>
      </link>
    </model>
    <model name="right_scanner">
      <static>true</static><pose>0 -2 0 0 0 0</pose>
      <link name="body">
        <collision name="body"><geometry><box><size>0.4 0.4 0.4</size></box></geometry></collision>
        <visual name="body"><geometry><box><size>0.4 0.4 0.4</size></box></geometry></visual>
        <sensor name="laser" type="lidar">
          <update_rate>50</update_rate><topic>/m54/right/scan</topic><frame_id>right_scanner/body/laser</frame_id>
          <lidar><scan><horizontal><samples>3</samples><resolution>1</resolution><min_angle>-0.5</min_angle><max_angle>0.5</max_angle></horizontal></scan><range><min>0.1</min><max>10</max><resolution>0.01</resolution></range></lidar>
        </sensor>
      </link>
    </model>
    <model name="wall">
      <static>true</static><pose>5 0 0 0 0 0</pose>
      <link name="body">
        <collision name="wall"><geometry><box><size>1 20 2</size></box></geometry></collision>
        <visual name="wall"><geometry><box><size>1 20 2</size></box></geometry></visual>
      </link>
    </model>
  </world>
</sdf>
