<sdf version="1.12">
  <world name="default">
    <gravity>0 0 -9.81</gravity>
    <physics name="contact_step" type="ode">
      <max_step_size>0.01</max_step_size>
    </physics>
    <model name="m1_stable_table">
      <static>true</static>
      <pose>-15 0 0.7 0 0 0</pose>
      <link name="link">
        <collision name="surface">
          <geometry>
            <box>
              <size>2.6 2.6 0.4</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>0</mu>
                <mu2>0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="paint">
          <geometry>
            <box>
              <size>2.6 2.6 0.4</size>
            </box>
          </geometry>
          <material>
            <diffuse>0.23 0.43 0.66 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="m2_stable_sphere">
      <static>false</static>
      <pose>-15 0 1.15 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>1</mass>
          <inertia>
            <ixx>0.016</ixx>
            <iyy>0.016</iyy>
            <izz>0.016</izz>
