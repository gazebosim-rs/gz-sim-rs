            </sphere>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>0</mu>
                <mu2>0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="paint">
          <geometry>
            <sphere>
              <radius>0.2</radius>
            </sphere>
          </geometry>
          <material>
            <diffuse>0.89 0.60 0.19 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="m3_driven_table">
      <static>true</static>
      <pose>15 0 0.7 0 0 0</pose>
      <link name="link">
        <collision name="surface">
          <geometry>
