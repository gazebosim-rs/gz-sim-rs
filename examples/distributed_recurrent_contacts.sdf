            </box>
          </geometry>
          <material>
            <diffuse>0.20 0.46 0.48 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="m4_driven_sphere">
      <static>false</static>
      <pose>15 0 1.15 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>1</mass>
          <inertia>
            <ixx>0.016</ixx>
            <iyy>0.016</iyy>
            <izz>0.016</izz>
