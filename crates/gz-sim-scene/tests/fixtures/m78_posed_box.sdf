<sdf version="1.12">
  <world name="default">
    <gravity>0 0 0</gravity>
    <model name="posed">
      <static>true</static>
      <pose>1 2 3 0 0 1.5707963267948966</pose>
      <frame name="mount" attached_to="body">
        <pose relative_to="body">1 -2 0.5 0 1.5707963267948966 0</pose>
      </frame>
      <link name="body">
        <pose>2 0 1 0 0 1.5707963267948966</pose>
        <collision name="shape">
          <pose relative_to="mount">0.5 0.25 -0.75 0 0 1.5707963267948966</pose>
          <geometry><box><size>1 2 3</size></box></geometry>
        </collision>
        <visual name="view">
          <pose>0 0 2 0 0 0</pose>
          <geometry><sphere><radius>0.1</radius></sphere></geometry>
        </visual>
        <sensor name="imu" type="imu">
          <pose relative_to="mount">0.5 2 -1 0 0 0</pose>
          <always_on>true</always_on><update_rate>1000</update_rate>
        </sensor>
      </link>
    </model>
    <model name="survivor">
      <static>true</static><pose>20 0 0 0 0 0</pose>
      <link name="body">
        <collision name="shape"><geometry><sphere><radius>0.5</radius></sphere></geometry></collision>
      </link>
    </model>
  </world>
</sdf>
