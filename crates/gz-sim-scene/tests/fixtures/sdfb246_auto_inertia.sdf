<sdf version='1.12'>
  <world name='default'>
    <gravity>0 0 0</gravity>
    <physics name='step' type='ode'><max_step_size>0.001</max_step_size></physics>
    <model name='box'>
      <pose>-3 0 5 0 0 0</pose>
      <static>false</static>
      <link name='body'>
        <inertial auto='true'/>
        <collision name='collision'>
          <density>1240</density>
          <geometry><box><size>2 2 2</size></box></geometry>
        </collision>
      </link>
    </model>
    <model name='sphere'>
      <pose>3 0 5 0 0 0</pose>
      <static>false</static>
      <link name='body'>
        <inertial auto='true'/>
        <collision name='collision'>
          <density>2170</density>
          <geometry><sphere><radius>0.1</radius></sphere></geometry>
        </collision>
      </link>
    </model>
  </world>
</sdf>
