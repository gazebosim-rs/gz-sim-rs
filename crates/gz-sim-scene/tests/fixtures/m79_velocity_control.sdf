<sdf version="1.12">
  <world name="default">
    <gravity>0 0 0</gravity>
    <physics name="p" type="ode"><max_step_size>0.001</max_step_size></physics>
    <model name="rig">
      <pose>0 0 10 0 0 0</pose>
      <plugin filename="gz-sim-velocity-control-system" name="gz::sim::systems::VelocityControl">
        <initial_linear>1 0 0</initial_linear><initial_angular>0 0 0</initial_angular>
      </plugin>
      <link name="body">
        <inertial><mass>2</mass><inertia><ixx>1</ixx><iyy>1</iyy><izz>1</izz></inertia></inertial>
        <collision name="shape"><geometry><sphere><radius>0.5</radius></sphere></geometry></collision>
        <visual name="view"><geometry><sphere><radius>0.5</radius></sphere></geometry></visual>
      </link>
    </model>
    <model name="survivor"><pose>20 0 10 0 0 0</pose><link name="body">
      <collision name="shape"><geometry><sphere><radius>0.5</radius></sphere></geometry></collision>
    </link></model>
  </world>
</sdf>
