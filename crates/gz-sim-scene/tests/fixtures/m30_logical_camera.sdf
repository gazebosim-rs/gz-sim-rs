<sdf version='1.12'><world name='default'>
  <gravity>0 0 0</gravity>
  <physics name='step' type='ode'><max_step_size>0.001</max_step_size></physics>
  <plugin filename='gz-sim-logical-camera-system' name='gz::sim::systems::LogicalCamera'/>
  <model name='rig'><pose>0 0 3 0 0 0</pose><link name='body'>
    <inertial><mass>1</mass><inertia><ixx>1</ixx><iyy>1</iyy><izz>1</izz></inertia></inertial>
    <collision name='box'><geometry><box><size>0.1 0.1 0.1</size></box></geometry></collision>
    <sensor name='logical_camera' type='logical_camera'>
      <pose>-1 0 0 0 0 0</pose>
      <always_on>true</always_on><update_rate>100</update_rate>
      <topic>/m30/logical_camera</topic><frame_id>rig/body/logical_camera</frame_id>
      <logical_camera><near>0.5</near><far>10</far><horizontal_fov>1.5707963267948966</horizontal_fov><aspect_ratio>1</aspect_ratio></logical_camera>
    </sensor>
  </link></model>
  <model name='target'><pose>4 0 3 0 0 0.5</pose><link name='body'>
    <inertial><mass>1</mass><inertia><ixx>1</ixx><iyy>1</iyy><izz>1</izz></inertia></inertial>
    <collision name='box'><geometry><box><size>0.1 0.1 0.1</size></box></geometry></collision>
  </link></model>
  <model name='behind'><static>true</static><pose>-3 0 3 0 0 0</pose><link name='body'><collision name='box'><geometry><box><size>0.1 0.1 0.1</size></box></geometry></collision></link></model>
</world></sdf>
