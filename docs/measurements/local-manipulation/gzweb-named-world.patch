+#[test]
+fn named_world_accepts_its_own_scoped_visuals() {
+    let mut input = scene_value(1);
+    input["world"] = json!("diff_drive");
+    input["visuals"][0]["name"] = json!("diff_drive::vehicle::chassis::visual");
+    assert!(parse(&input.to_string()).is_ok());
+    for invalid in ["", "a::b", "bad\nworld"] {
+        input["world"] = json!(invalid);
+        assert!(parse(&input.to_string()).is_err());
+    }
+}
